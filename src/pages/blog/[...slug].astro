---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Ahmed Abdelrehim`} description={post.data.description}>
  <div class="container">
    <article class="prose post">
      <p class="back-row"><a href="/blog">← All posts</a></p>
      <h1>{post.data.title}</h1>
      <p class="date">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </p>
      <div class="post-body">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  /* Full-width reading column that scrolls naturally */
  :global(.site-header .container),
  .container {
    max-width: min(1600px, 96vw);
  }
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }
  .post .back-row {
    margin: 0 0 1rem;
  }
  .post h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0 0 0.25rem;
  }
  .post .date {
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  .post-body :global(p),
  .post-body :global(li) {
    font-size: 1.05rem;
    line-height: 1.7;
  }
</style>
