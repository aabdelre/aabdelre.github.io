  }
  .bio-col .hero-head {
    margin-bottom: 1.25rem;
  }
  .bio-col .hero h1 {
    font-size: 2.6rem;
    margin: 0 0 0.4rem;
  }
  .bio-col .term-body .out-accent {
    font-size: 1.1rem;
    margin: 0 0 0.25rem;
  }
  .bio-col .term-body p {
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 0.9rem;
  }
  .bio-col .socials {
    gap: 0.75rem;
  }
  /* Left column matches the map height exactly: the bio window fills it,
     and the open-links window sits below at its natural height. */
  .bio-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem; /* matches the column gap on .landing */
  }
  .bio-col .hero {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem; /* same spacing as under the menu bar */
    padding: 0;
  }
  .bio-col .term-window:not(.links-win) {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .bio-col .term-window:not(.links-win) .term-body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .bio-col .links-win {
    flex: none;
  }
  .bio-col .links-win .term-body {
    padding: 1rem 1.5rem;
  }
  /* Map column has no top padding, so its top and bottom match the bio column */
  .map-col .map-section {
    padding: 0;
  }
  .bio-col .icon-link {
    width: 44px;
    height: 44px;
  }
  .bio-col .icon-link svg {
    width: 22px;
    height: 22px;
  }
  .map-col {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .map-section {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 2rem 0 0;
    border-bottom: none;
  }
  .map-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
  }
  .map-canvas {
    position: absolute;
    inset: 0;
    transform-origin: var(--zx, 50%) var(--zy, 50%);
    transform: translate(var(--px, 0px), var(--py, 0px)) scale(var(--us, 1));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Pin zoom: at least 1.7x, from wherever the user has zoomed */
  .map-stage.is-zooming .map-canvas {
    transform: translate(var(--px, 0px), var(--py, 0px))
      scale(max(var(--us, 1), 1.7));
    transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .map-stage.is-dragging .map-canvas {
    transition: none;
