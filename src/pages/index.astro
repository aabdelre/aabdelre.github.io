              <!-- Robot arm skeleton: base on the right edge, reaching left -->
              <div class="map-arm" aria-hidden="true">
                <svg viewBox="0 0 360 400">
                  <rect x="292" y="386" width="76" height="14" fill="none" stroke="#3fb950" stroke-width="1.5" stroke-dasharray="3 2" />
                  <rect x="324" y="376" width="12" height="12" fill="#0d1117" stroke="#3fb950" stroke-width="1.5" />
                  <polyline id="arm-l1" points="" fill="none" stroke="#3fb950" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" />
                  <polyline id="arm-l2" points="" fill="none" stroke="#3fb950" stroke-width="2" stroke-opacity="0.7" stroke-linecap="square" stroke-linejoin="miter" stroke-dasharray="6 3" />
                  <polyline id="arm-l3" points="" fill="none" stroke="#8b949e" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" />
                  <g id="arm-fingers" stroke="#3fb950" stroke-width="2" stroke-linecap="square" />
                </svg>
              </div>
              <script>
                (function () {
                  var l1 = document.getElementById('arm-l1');
                  if (!l1) return;
                  var L1 = 130, L2 = 110, L3 = 56;
                  var base = { x: 330, y: 382 };
                  var l2 = document.getElementById('arm-l2');
                  var l3 = document.getElementById('arm-l3');
                  var fingers = document.getElementById('arm-fingers');
                  var rad = function (d) { return (d * Math.PI) / 180; };
                  var pt = function (p) { return p.x.toFixed(1) + ',' + p.y.toFixed(1); };
                  // grip opens and closes at random intervals, easing between states
                  var grip = 32, gripTarget = 32, nextToggle = 0, lastT = 0;
                  function updateGrip(t) {
                    if (t >= nextToggle) {
                      gripTarget = gripTarget > 18 ? -6 : 32;
                      nextToggle = t + 0.8 + Math.random() * 2.2;
                    }
                    var dt = Math.max(0, t - lastT);
                    lastT = t;
                    grip += (gripTarget - grip) * Math.min(1, dt * 5);
                    return grip;
                  }
                  var smoothState = {};
                  function smooth(k, target, t) {
                    var e = smoothState[k];
                    if (!e) { smoothState[k] = { v: target, t: t }; return target; }
                    var dt = Math.min(0.1, Math.max(0, t - e.t));
                    e.v += (target - e.v) * (1 - Math.exp(-dt * 6));
                    e.t = t;
                    return e.v;
                  }
                  function pose(t) {
                    var j1 = smooth('j1', 35 * Math.sin(t * 0.6), t);
                    var j2 = smooth('j2', 30 + 22 * Math.sin(t * 0.8), t);
                    var j3 = smooth('j3', 50 + 30 * Math.sin(t * 0.9 + 1), t);
                    var c1 = smooth('c1', -15 + 25 * Math.sin(t * 1.1), t);
                    var c2 = smooth('c2', 70 * Math.sin(t * 0.7), t);
                    var c3 = updateGrip(t);
                    var yaw = Math.cos(rad(j1));
                    var a1 = rad(j2), a2 = rad(j2 + j3), a3 = rad(j2 + j3 + c1);
                    var p1 = { x: base.x - L1 * Math.sin(a1) * yaw, y: base.y - L1 * Math.cos(a1) };
                    var p2 = { x: p1.x - L2 * Math.sin(a2) * yaw, y: p1.y - L2 * Math.cos(a2) };
                    var p3 = { x: p2.x - L3 * Math.sin(a3) * yaw, y: p2.y - L3 * Math.cos(a3) };
                    l1.setAttribute('points', pt(base) + ' ' + pt(p1));
                    l2.setAttribute('points', pt(p1) + ' ' + pt(p2));
                    l3.setAttribute('points', pt(p2) + ' ' + pt(p3));
                    var dir = a3 + rad(c2 * 0.15);
                    // claw: palm bar at the wrist, two jaws that open outward then hook inward
                    var spread = rad(10 + c3);
                    var hook = rad(30);
                    var dirAt = function (base, ang, len) {
                      return { x: base.x - Math.sin(ang) * len * yaw, y: base.y - Math.cos(ang) * len };
                    };
                    var perp = dir + Math.PI / 2;
                    var pa = dirAt(p3, perp, 6);
                    var pb = dirAt(p3, perp + Math.PI, 6);
                    var a1 = dirAt(pa, dir + spread, 12);
                    var a2 = dirAt(a1, dir + spread - hook, 9);
                    var b1 = dirAt(pb, dir - spread, 12);
                    var b2 = dirAt(b1, dir - spread + hook, 9);
                    fingers.innerHTML =
                      '<polyline points="' + pt(pa) + ' ' + pt(pb) + '" fill="none"/>' +
                      '<polyline points="' + pt(pa) + ' ' + pt(a1) + ' ' + pt(a2) + '" fill="none"/>' +
                      '<polyline points="' + pt(pb) + ' ' + pt(b1) + ' ' + pt(b2) + '" fill="none"/>';
                  }
                  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    pose(0);
                    return;
                  }
                  function frame(now) {
                    pose(now / 1000);
                    requestAnimationFrame(frame);
                  }
                  requestAnimationFrame(frame);
                })();
