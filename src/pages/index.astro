    text-underline-offset: 3px;
  }
  .cmd:hover {
    color: var(--accent-hover);
  }
  .cmd:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Pins */
  .pin {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--text);
    font-family: var(--mono);
    text-decoration: none;
    cursor: pointer;
  }
  .pin:hover {
    color: var(--strong);
    text-decoration: none;
  }
  .pin:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 6px;
  }
  .pin-dot {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .pin-dot::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: pin-pulse 2.2s ease-out infinite;
  }
  .pin-label {
    font-size: 0.85rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }
  .pin-num {
    color: var(--accent);
    margin-right: 0.3rem;
  }
  .pin.is-active .pin-dot {
    background: var(--strong);
  }
  .pin.is-active .pin-label {
    border-color: var(--accent);
    color: var(--accent);
  }
  @keyframes pin-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
