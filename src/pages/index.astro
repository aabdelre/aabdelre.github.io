---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// ---- Edit your content here -------------------------------------------------
// Map pins. x/y are percentages across the map. `id` must match a panel below.
const pins = [
  { id: 'experience', num: '01', label: 'Experience', x: 24, y: 34 },
  { id: 'research', num: '02', label: 'Research', x: 50, y: 20 },
  { id: 'projects', num: '03', label: 'Projects', x: 76, y: 34 },
  { id: 'blog', num: '04', label: 'Blog', x: 32, y: 72 },
  { id: 'beyond', num: '05', label: 'Beyond', x: 70, y: 72 },
];

const projects = [
  {
    name: 'Probe Layer',
    description:
      'A bias-audit platform with a public audit page, per-submission audit log, JSON API, and a browser extension.',
    tags: ['TypeScript', 'Web', 'Browser Extension'],
    demo: '#',
    repo: '#',
  },
  {
    name: 'Token Price Calculator',
    description:
      'Compares token prices across enterprise and free-tier models hosted on AWS.',
    tags: ['AWS', 'Pricing'],
    demo: '#',
    repo: '#',
  },
  {
    name: 'Menu Gen',
    description:
      'Turns a menu scan into an image-based menu, showing each dish with its ingredients. Uses Nano Banana to estimate what each dish might look like.',
    tags: ['Nano Banana', 'Image Generation'],
    demo: '#',
    repo: '#',
  },
];

const experience = [
  {
    role: 'Co-Founder & CTO',
    org: 'Stealth Startup',
    period: 'Mar 2026 — Present',
    summary:
      'Building an AI-native LMS for AI-assisted curriculum building, teaching, assessment, and grading; benchmarking 10+ models for grading quality.',
  },
  {
    role: 'Software Engineer, ML Infrastructure',
    org: 'Meta',
    period: 'Feb 2025 — Present',
    summary:
      'Build ML workflow orchestration for Ads ranking — cut model-iteration latency ~88% and drove avg 2.45% accuracy gains across production models.',
  },
  {
    role: 'Software Engineer Intern',
    org: 'HPE — Juniper Networking',
    period: 'May 2024 — Aug 2024',
    summary:
      'Rewrote a Python microservice (−72% code) and migrated Address Pool Manager monitoring to Prometheus/Grafana with custom gRPC metrics endpoints on Kubernetes.',
  },
  {
    role: 'Software Developer',
    org: 'Hamilton College R&ID Team',
    period: 'Jun 2023 — Jan 2024',
    summary:
      'Built an inventory app on AWS (DynamoDB, S3, Lambda) behind a Django REST API, and revamped a 7-page digital archive in React.',
  },
];

const education = [
  {
    role: 'B.A., Computer Science & Mathematics · Hamilton College',
    meta: 'Clinton, NY · Dec 2024 · GPA 3.88',
    summary:
      "Magna Cum Laude · CS Honors · Phi Beta Kappa · Dean's List (every semester)",
  },
  {
    role: 'Study Abroad · The University of Manchester',
    meta: 'Manchester, UK · Jan 2023 — Jan 2024 · Merit-based',
    summary: 'Year abroad awarded for merit.',
  },
];

const research = [
  {
    name: 'Human-Driven Genetic Programming (HDGP)',
    role: 'Do counterexamples let non-experts verify programs without labeling hundreds of cases?',
    org: 'Hamilton College CS Department',
    period: '2023',
    summary:
      "Co-authored a GECCO '23 workshop paper on Human-Driven Genetic Programming. Non-experts give about five input-output examples, then verify candidate programs on auto-generated counterexamples instead of labeling hundreds of cases, an 11% reduction. I tuned PushGP, fixed benchmarks and evaluation functions, and analyzed experiments in R. Presented at Hamilton's annual research expo.",
    poster:
      'https://drive.google.com/file/d/1dzpNwBr2ef_vshR0SRdZVnXamdxb32Zd/view?usp=sharing',
    paper: 'https://dl.acm.org/doi/abs/10.1145/3583133.3596373',
    project:
      'https://drive.google.com/file/d/12rHC_vamsPnrEZp0ttqf_5AIpDW4Mu9-/view?usp=sharing',
  },
  {
    name: 'Vertex Clique Coverage',
    role: 'What if a huge graph’s complement never had to fit in memory?',
    summary:
      "Designed a modified DSATUR heuristic that colors large graph complements implicitly with a new 'grayness degree', then ported it to C++. On SNAP graphs, clique counts landed within 1% of exact or best-known bounds, and profiling cut runtime about 10x (19s to 2s). I also tested Tabu search as an alternative.",
  },
  {
    name: 'LLMs with Databases',
    role: "Could a language model write a database's API from its schema alone?",
    summary:
      "Tested whether the GPT-3 API could write a database's GET and POST endpoints from only its schema, so a UI could read and write data with no hand-written backend. I designed the prompts, built the endpoints from the model's output, and verified them end to end. Verifying that generated code works is still the question I work on in production.",
  },
  {
    name: 'Irish Music Composer',
    role: 'Which composer’s fingerprint hides inside an unattributed reel?',
    summary:
      'Team research project for a biology professor and Irish music enthusiast: which of 36 unattributed reels did fiddler John McFadden compose? I collected 158 reels in ABC notation and built a CLI and a UI to add tunes, test unknown ones, and visualize clusters of 20 musical features. Our best model (K-means, an MLP, and fine-tuned BERT were compared) reached 68% validation accuracy, limited by the amount of data.',
    presentation:
      'https://drive.google.com/file/d/1yqd0Ps7oHD0w2pgkXvhwaG3kVZR3DQQT/view?usp=sharing',
  },
  {
    name: 'Emotion Detection',
    role: "Where does a viewer's emotion live: in the words, the voice, or the face?",
    summary:
      "Semester-long project predicting a viewer's emotions continuously as a scene unfolds, not one label per clip. The architecture fuses dialogue (BERT), vocal tone (ResNet on mel-spectrograms), and facial expressions (ResNet). I gathered and prepared data from RAVDESS, CMU-MOSEI, IEMOCAP, MELD, and a dataset we collected from Hamilton students, reaching 83% accuracy on 7 emotions.",
  },
];

const beyond = [
  {
    title: 'Volleyball',
    text: "I've played volleyball leagues since senior year, and have been progressing with my team through Volo leagues. Our highest finish so far is 2nd place.",
    images: ['/volleyball/team.jpg', '/volleyball/successful-dig.jpg', '/volleyball/failed-spiking.jpg'],
  },
  {
    title: 'Hiking',
    text: "I really love driving and touching grass. Getting out of the city, whether it's a long drive or a trail, is how I recharge from debugging, metrics analysis, and demos. The world indeed has pretty impressive graphics.",
    images: ['/hiking/tahoe-driving.mp4', '/hiking/zion.jpg', '/hiking/yosemite-lower.jpg'],
  },
  {
    title: 'Hackathons',
    text: "I love sharing knowledge and helping communities grow, so I volunteer to mentor and judge hackathons, and take part in them myself.",
    images: ['/hackathons/hackmit.jpg', '/hackathons/calhacks.jpg', '/hackathons/hamilton-hack.jpg'],
  },
];
// -----------------------------------------------------------------------------

// Latest 3 blog posts, newest first
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title="Ahmed Abdelrehim">
  <div class="container">
    <div class="landing" data-landing>
      <!-- Left column: bio terminal -->
      <div class="bio-col">
        <section class="hero" id="about">
          <div class="term-window">
            <div class="term-bar">
              <i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i>
              <span class="title">aabdelre — zsh</span>
            </div>
            <div class="term-body">
              <p class="prompt">whoami</p>
              <div class="hero-head">
                <div>
                  <h1>Hi, I'm Ahmed!</h1>
                  <p class="out-accent">AI/ML &amp; EdTech enthusiast. Aspiring disrupter.</p>
                </div>
              </div>
              <p class="prompt">cat about.txt</p>
              <p>
                I'm a software and machine learning engineer at Meta, building the
                systems that train and improve the models behind ads ranking.
              </p>
              <p>
                I love teaching, so I'm co-founding an AI startup that helps
                teachers design courses, give feedback, grade work, and unlock 24/7 office hours.
              </p>
              <p class="prompt">
                <button class="cmd" type="button" data-explore>explore ./map</button>
              </p>
              <p class="prompt"><span class="caret"></span></p>
            </div>
          </div>
          <div class="term-window links-win">
            <div class="term-bar">
              <i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i>
              <span class="title">aabdelre — links</span>
            </div>
            <div class="term-body">
              <p class="prompt">open links</p>
              <div class="socials">
                <a class="icon-link" href="https://github.com/aabdelre" aria-label="GitHub" title="GitHub">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                </a>
                <a class="icon-link" href="https://www.linkedin.com/in/aash2024/" aria-label="LinkedIn" title="LinkedIn">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
                <a class="icon-link" href="mailto:aabdelre.ahmed@gmail.com" aria-label="Email" title="Email">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                </a>
                <a class="icon-link" href="/resume.pdf" aria-label="Résumé (PDF)" title="Résumé (PDF)">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h8"/></svg>
                </a>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Right column: map with popup -->
      <div class="map-col">
        <button class="back-bio" type="button" data-back-bio>← back to bio</button>
        <section class="map-section" id="map" aria-label="Interactive map">
          <div class="map-stage" data-map-stage>
            <div class="map-canvas" data-map-canvas>
              <svg
                class="map-svg"
                viewBox="0 0 1000 625"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
                focusable="false"
              >
                <defs>
                  <pattern id="map-grid" width="50" height="50" patternUnits="userSpaceOnUse">
                    <path d="M50 0H0V50" class="grid-line" fill="none" />
                  </pattern>
                </defs>
                <rect width="1000" height="625" fill="url(#map-grid)" />
                <path class="land" d="M80 90 C200 40 340 70 380 150 C420 230 330 260 250 300 C170 340 60 300 40 220 Z" />
                <path class="land" d="M600 380 C700 340 880 360 920 450 C960 540 860 580 760 570 C660 560 560 520 560 450 Z" />
                <path class="land" d="M430 470 C520 440 600 500 580 560 C560 610 440 600 420 550 Z" />
                <path class="land" d="M720 60 C820 40 940 90 950 180 C960 260 860 260 800 240 C740 220 680 120 720 60 Z" />
              </svg>

              <!-- Routes: from the map centre to each pin, in the same percentage space as the pins -->
              <svg class="route-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                {
                  pins.map((p) => (
                    <line class="route" x1="50" y1="50" x2={p.x} y2={p.y} />
                  ))
                }
              </svg>

              <!-- Live background: radar, flight paths, drifting tokens, map symbols -->
              <div class="bg-layer" aria-hidden="true">
                <div class="radar-ring" style="width:220px;height:220px;"></div>
                <div class="radar-ring" style="width:380px;height:380px;"></div>
                <div class="radar"></div>
                <svg class="bg-paths" viewBox="0 0 1000 625" preserveAspectRatio="none">
                  <path d="M40 560 Q 260 430 480 520 T 930 470" />
                  <path d="M60 120 Q 300 40 520 130 T 960 90" />
                  <path d="M150 300 Q 420 240 640 330" />
                </svg>
                <span class="mover" style="left:38%;top:70%;"></span>
                <span class="mover" style="left:62%;top:20%;"></span>
                <span class="mover mover-b" style="left:22%;top:48%;"></span>
                <span class="pt" style="left:12%;top:40%;"></span>
                <span class="pt" style="left:33%;top:8%;animation-delay:-1s;"></span>
                <span class="pt" style="left:58%;top:86%;animation-delay:-2s;"></span>
                <span class="pt" style="left:88%;top:30%;animation-delay:-1.5s;"></span>
                <span class="pt" style="left:6%;top:88%;animation-delay:-2.5s;"></span>
                <span class="pt" style="left:94%;top:82%;animation-delay:-0.5s;"></span>
                <span class="pt" style="left:46%;top:44%;animation-delay:-1.8s;"></span>
                <span class="pt" style="left:80%;top:12%;animation-delay:-2.2s;"></span>
                <span class="tok" style="left:4%;top:24%;">−88% latency</span>
                <span class="tok alt" style="left:86%;top:54%;">+2.45%</span>
                <span class="tok warn" style="left:14%;top:70%;">~102 hrs / yr</span>
                <span class="tok" style="left:62%;top:6%;animation-delay:-3s;">{'{ }'}</span>
                <span class="tok alt" style="left:44%;top:92%;animation-delay:-5s;">=&gt;</span>
                <span class="tok" style="left:92%;top:40%;animation-delay:-6s;">+1.45% NE</span>
                <span class="tok warn" style="left:28%;top:34%;animation-delay:-2s;">−72% code</span>
                <span class="tok alt" style="left:70%;top:76%;animation-delay:-7s;">git push</span>
                <span class="tri" style="left:84%;top:86%;"></span>
                <span class="tri tri-s" style="left:88%;top:88%;"></span>
                <span class="net" style="left:52%;top:62%;"></span>
                <span class="brk" style="left:60%;top:48%;">&lt;/&gt;</span>
                <span class="brk" style="left:10%;top:56%;animation-delay:-4s;">{'{ }'}</span>
                <span class="ring" style="left:50%;top:20%;"></span>
                <span class="glyph" style="left:68%;top:44%;">{'{ }'}</span>
                <span class="glyph" style="left:80%;top:40%;animation-delay:-2s;">=&gt;</span>
                <span class="glyph" style="left:88%;top:48%;animation-delay:-3.5s;">#</span>
                <div class="compass"><div class="needle"></div></div>
                <div class="scan"></div>
              </div>

              <!-- Pin widgets: one live readout per section -->
              <div class="w w-research">
                <b>loss ↓ 11%</b> · genetic programming
                <svg class="wave-svg" viewBox="0 0 186 46" aria-hidden="true">
                  <path class="wave" d="M0 30 Q 23 6 46 24 T 93 18 T 140 22 T 186 8" />
                </svg>
              </div>
              <div class="w w-exp">
                <b>ranking · Ads models</b>
                <div class="rank rise"><span>orchestrator</span><span>−88% latency</span></div>
                <div class="rank"><span>feature swap</span><span>+1.45% NE</span></div>
                <div class="rank rise delay"><span>avg accuracy</span><span>+2.45%</span></div>
                <div class="agent-line">agent&gt; iterating<span class="blink">_</span></div>
              </div>
              <div class="w w-proj">
                <b>{projects[0]?.name}</b> · audit log
                <div class="code-line">bias_audit.run()<span class="blink">_</span></div>
              </div>
              <div class="w w-blog">
                <b>latest writing</b>
                <div class="clip">{posts[0]?.data.title}</div>
              </div>
              <div class="w w-beyond">
                <b>off the map</b>
                <div>volleyball · hiking</div>
                <div>hackathons · judging · mentoring</div>
              </div>

              {
                pins.map((p) => (
                  <a
                    class="pin"
                    href={`#${p.id}`}
                    data-pin={p.id}
                    data-pos={`${p.x},${p.y}`}
                    style={`left:${p.x}%;top:${p.y}%`}
                    aria-label={`Open ${p.label}`}
                  >
                    <span class="pin-dot"></span>
                    <span class="pin-label"><span class="pin-num">{p.num}</span> {p.label}</span>
                  </a>
                ))
              }
            </div>

            <div class="zoom-controls">
              <button type="button" data-zoom-in aria-label="Zoom in">+</button>
              <button type="button" data-zoom-out aria-label="Zoom out">−</button>
              <button type="button" data-zoom-reset aria-label="Reset zoom">⤢</button>
            </div>

            <!-- Popup: section content, paged, on top of the map -->
            <div class="popup" data-popup hidden role="dialog" aria-modal="false" aria-labelledby="popup-title">
              <div class="popup-head">
                <span class="popup-title" id="popup-title" data-popup-title></span>
                <button class="back" type="button" data-close>close ✕</button>
              </div>
              <div class="popup-body">
                <div class="panel" data-panel="experience" data-title="git log --oneline experience" hidden>
                  <div class="photo-slot">[ photo: experience ]</div>
                  {
                    experience.map((e) => (
                      <div class="page" data-page>
                        <div class="role">{e.role} · {e.org}</div>
                        <div class="meta">{e.period}</div>
                        <p>{e.summary}</p>
                      </div>
                    ))
                  }
                  {
                    education.map((ed) => (
                      <div class="page" data-page>
                        <div class="role">{ed.role}</div>
                        <div class="meta">{ed.meta}</div>
                        <p>{ed.summary}</p>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="research" data-title="ls ./research --board" data-mode="board" hidden>
                  <!-- Whiteboard of research: click a card to open it -->
                  <div class="board" data-board>
                    <svg class="wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                      <path d="M31 22 C 33 16, 34 28, 36 22" />
                      <path d="M16 36 C 11 44, 22 48, 16 56" />
                      <path d="M81 36 C 84 44, 77 48, 81 56" />
                      <path d="M31 70 C 45 61, 55 79, 68 70" />
                    </svg>
                    {
                      research.map((r, i) => (
                        <button class="rcard" type="button" data-rcard={i} style={`left:${[4, 36, 68, 4, 68][i]}%;top:${[8, 8, 8, 56, 56][i]}%`}>
                          <span class="rbar" style={`background:${['var(--accent)', '#58a6ff', 'var(--warn)', '#bc8cff', '#ff7b72'][i]}`}></span>
                          <span class="rtitle">{r.role}</span>
                          <span class="rsub">{r.name ?? ''}</span>
                        </button>
                      ))
                    }
                    <span class="hand hand-1">research, 2022 — now</span>
                    <span class="hand hand-2">the verifier missed 2!</span>
                    <span class="hand hand-3">go deeper →</span>
                    <span class="hand hand-4">click a card to open it</span>
                  </div>
                  {
                    research.map((r, i) => (
                      <div class="rdetail" data-rdetail={i} hidden>
                        <div class="nb">
                          <aside class="nb-side">
                            <button class="back" type="button" data-rup>← board</button>
                            <div class="nb-ls">$ ls ./research</div>
                            {research.map((x, j) => (
                              <button class={`nb-item${j === i ? ' on' : ''}`} type="button" data-rjump={j}>
                                <span>{x.role}</span>
                                <small>{x.name ?? ''}</small>
                              </button>
                            ))}
                          </aside>
                          <div class="nb-main">
                            <div class="nb-title">{r.role}</div>
                            {(r.name || r.org || r.period) && <div class="nb-meta">{[r.name, r.org, r.period].filter(Boolean).join(' · ')}</div>}
                            <div class="nb-cell">
                              <div class="nb-head">[1] the idea</div>
                              <p>{r.summary}</p>
                            </div>
                            {(r.poster || r.paper || r.project || r.presentation) && (
                              <div class="nb-cell">
                                <div class="nb-head">[2] artifacts</div>
                                <ul class="nb-links">
                                  {r.poster && <li><a href={r.poster} target="_blank" rel="noopener">poster →</a></li>}
                                  {r.paper && <li><a href={r.paper} target="_blank" rel="noopener">paper →</a></li>}
                                  {r.project && <li><a href={r.project} target="_blank" rel="noopener">GECCO presentation →</a></li>}
                                  {r.presentation && <li><a href={r.presentation} target="_blank" rel="noopener">presentation →</a></li>}
                                </ul>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="projects" data-title="ls ./projects" data-mode="folders" hidden>
                  <!-- Desktop of project folders: double-click one to open it -->
                  <div class="desk" data-desk>
                    {
                      projects.map((p, i) => (
                        <button class="folder" type="button" data-folder={i} aria-label={`Open folder ${p.name}`}>
                          <svg class="folder-icon" viewBox="0 0 24 20" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M1 3a2 2 0 0 1 2-2h5l2 2h11a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2z" />
                          </svg>
                          <span class="folder-name">{p.name}</span>
                        </button>
                      ))
                    }
                  </div>
                  {
                    projects.map((p, i) => (
                      <div class="project-win" data-project-win={i} hidden>
                        <div class="win-bar">
                          <i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i>
                          <span class="win-title">{p.name}</span>
                          <button class="win-close" type="button" data-up aria-label="Close window">×</button>
                        </div>
                        <div class="role">{p.name}</div>
                        <div class="meta">{p.tags.join(' · ')}</div>
                        <p>{p.description}</p>
                        <div class="card-links">
                          {p.demo && p.demo !== '#' && <a href={p.demo}>Live</a>}
                          {p.repo && p.repo !== '#' && <a href={p.repo}>Code</a>}
                        </div>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="blog" data-title="tail -n 3 ./blog" hidden>
                  {
                    posts.map((post) => (
                      <div class="page" data-page>
                        <div class="meta">
                          <time datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            })}
                          </time>
                        </div>
                        <div class="role"><a href={`/blog/${post.id}`}>{post.data.title}</a></div>
                        <p>{post.data.description}</p>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="beyond" data-title="ls ./beyond" hidden>
                  {
                    beyond.map((b) => (
                      <div class="page" data-page>
                        {!b.images && <div class="role">{b.title}</div>}
                        {!b.images && b.text && <p>{b.text}</p>}
                        {b.images && (
                          <div class="split">
                            <div class="split-text">
                              <div class="role">{b.title}</div>
                              {b.text && <p>{b.text}</p>}
                              <figure class="shot">
                                <div class="shot-bar">
                                  <i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i>
                                  <span>{b.images[0].split('/').pop()}</span>
                                </div>
                                {b.images[0].endsWith('.mp4') ? (
                                  <video src={b.images[0]} autoplay muted loop playsinline aria-label="Driving clip"></video>
                                ) : (
                                  <img src={b.images[0]} alt={`${b.title} photo`} loading="lazy" />
                                )}
                              </figure>
                            </div>
                            <div class="split-imgs">
                              {b.images.slice(1).map((src) => (
                                <figure class="shot">
                                  <div class="shot-bar">
                                    <i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i>
                                    <span>{src.split('/').pop()}</span>
                                  </div>
                                  {src.endsWith('.mp4') ? (
                                    <video src={src} autoplay muted loop playsinline aria-label="Driving clip"></video>
                                  ) : (
                                    <img src={src} alt={`${b.title} photo`} loading="lazy" />
                                  )}
                                </figure>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    ))
                  }
                </div>
              </div>
              <div class="popup-foot">
                <button type="button" data-prev>← prev</button>
                <span data-count>1 / 1</span>
                <button type="button" data-next>next →</button>
                <span class="foot-os" data-foot-os hidden>ahmed.os</span>
                <span class="foot-time" data-foot-time hidden></span>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap');

  /* Homepage only: widen the page and header to nearly full screen */
