---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// ---- Edit your content here -------------------------------------------------
// Map pins. x/y are percentages across the map. `id` must match a panel below.
const pins = [
  { id: 'experience', label: 'Experience', x: 24, y: 34 },
  { id: 'research', label: 'Research', x: 50, y: 20 },
  { id: 'projects', label: 'Projects', x: 76, y: 34 },
  { id: 'blog', label: 'Blog', x: 32, y: 72 },
  { id: 'beyond', label: 'Beyond', x: 70, y: 72 },
];

const projects = [
  {
    name: 'Probe Layer',
    description:
      'A bias-audit platform with a public audit page, per-submission audit log, JSON API, and a browser extension.',
    tags: ['TypeScript', 'Web', 'Browser Extension'],
    demo: '#',
    repo: '#',
  },
  {
    name: 'Project Two',
    description: 'Short, punchy description of what it does and why it matters.',
    tags: ['Python', 'API'],
    demo: '#',
    repo: '#',
  },
  {
    name: 'Project Three',
    description: 'Another highlight. Keep it to one or two sentences.',
    tags: ['React'],
    demo: '#',
    repo: '#',
  },
];

const experience = [
  {
    role: 'Co-Founder & CTO',
    org: 'Stealth Startup',
    period: 'Mar 2026 — Present',
    summary:
      'Building an AI-native LMS for AI-assisted curriculum building, teaching, assessment, and grading; benchmarking 10+ models for grading quality.',
  },
  {
    role: 'Software Engineer, ML Infrastructure',
    org: 'Meta',
    period: 'Feb 2025 — Present',
    summary:
      'Build ML workflow orchestration for Ads ranking — cut model-iteration latency ~88% and drove avg 2.45% accuracy gains across production models.',
  },
  {
    role: 'Software Engineer Intern',
    org: 'HPE — Juniper Networking',
    period: 'May 2024 — Aug 2024',
    summary:
      'Rewrote a Python microservice (−72% code) and migrated Address Pool Manager monitoring to Prometheus/Grafana with custom gRPC metrics endpoints on Kubernetes.',
  },
  {
    role: 'Software Developer',
    org: 'Hamilton College R&ID Team',
    period: 'Jun 2023 — Jan 2024',
    summary:
      'Built an inventory app on AWS (DynamoDB, S3, Lambda) behind a Django REST API, and revamped a 7-page digital archive in React.',
  },
];

const education = [
  {
    role: 'B.A., Computer Science & Mathematics · Hamilton College',
    meta: 'Clinton, NY · Dec 2024 · GPA 3.88',
    summary:
      "Magna Cum Laude · CS Honors · Phi Beta Kappa · Dean's List (every semester)",
  },
  {
    role: 'Study Abroad · The University of Manchester',
    meta: 'Manchester, UK · Jan 2023 — Jan 2024 · Merit-based',
    summary: 'Year abroad awarded for merit.',
  },
];

const research = [
  {
    role: 'ML Research Assistant',
    org: 'Hamilton College CS Department',
    period: 'May 2022 — Aug 2022',
    summary:
      'Fine-tuned a Clojure genetic-programming model (−11% training cases) and automated HPC experiment runs with results visualization.',
  },
];

const beyond = ['Volleyball', 'Hiking', 'Hackathon participation, mentoring, and judging'];
// -----------------------------------------------------------------------------

// Latest 3 blog posts, newest first
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title="Ahmed Abdelrehim">
  <div class="container">
    <div class="landing" data-landing>
      <!-- Left column: bio terminal -->
      <div class="bio-col">
        <section class="hero" id="about">
          <div class="term-window">
            <div class="term-bar">
              <i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i>
              <span class="title">aabdelre — zsh</span>
            </div>
            <div class="term-body">
              <p class="prompt">whoami</p>
              <div class="hero-head">
                <div>
                  <h1>Hi, I'm Ahmed!</h1>
                  <p class="out-accent">AI/ML enthusiast. Aspiring disrupter.</p>
                </div>
              </div>
              <p class="prompt">cat about.txt</p>
              <p>
                I'm a software and machine learning engineer at Meta, where I build
                the systems that train and improve the models deciding which ads
                people see. I work on the models themselves, testing which
                techniques actually help and building tools that make that testing
                faster and more reliable.
              </p>
              <p>
                I love explaining things, and I learn best by building. That's why
                I'm now co-founding an AI startup that helps teachers design
                courses, give feedback, and grade work, with people in the loop at
                every step. I want to bring what I've learned about getting ML to
                work reliably at scale into the classroom, where getting it right
                matters just as much.
              </p>
              <p class="prompt">open links</p>
              <div class="socials">
                <a class="icon-link" href="https://github.com/aabdelre" aria-label="GitHub" title="GitHub">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                </a>
                <a class="icon-link" href="https://www.linkedin.com/in/aash2024/" aria-label="LinkedIn" title="LinkedIn">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
                <a class="icon-link" href="mailto:aabdelre.ahmed@gmail.com" aria-label="Email" title="Email">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                </a>
                <a class="icon-link" href="/resume.pdf" aria-label="Résumé (PDF)" title="Résumé (PDF)">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h8"/></svg>
                </a>
              </div>
              <p class="prompt">
                <button class="cmd" type="button" data-explore>explore ./map</button>
              </p>
              <p class="prompt"><span class="caret"></span></p>
            </div>
          </div>
        </section>
      </div>

      <!-- Right column: map with popup -->
      <div class="map-col">
        <button class="back-bio" type="button" data-back-bio>← back to bio</button>
        <section class="map-section" id="map" aria-label="Interactive map">
          <div class="map-stage" data-map-stage>
            <div class="map-canvas" data-map-canvas>
              <svg
                class="map-svg"
                viewBox="0 0 1000 625"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
                focusable="false"
              >
                <defs>
                  <pattern id="map-grid" width="50" height="50" patternUnits="userSpaceOnUse">
                    <path d="M50 0H0V50" class="grid-line" fill="none" />
                  </pattern>
                </defs>
                <rect width="1000" height="625" fill="url(#map-grid)" />
                <path class="land" d="M80 90 C200 40 340 70 380 150 C420 230 330 260 250 300 C170 340 60 300 40 220 Z" />
                <path class="land" d="M600 380 C700 340 880 360 920 450 C960 540 860 580 760 570 C660 560 560 520 560 450 Z" />
                <path class="land" d="M430 470 C520 440 600 500 580 560 C560 610 440 600 420 550 Z" />
                <path class="land" d="M720 60 C820 40 940 90 950 180 C960 260 860 260 800 240 C740 220 680 120 720 60 Z" />
                {
                  pins.map((p) => (
                    <line class="route" x1="500" y1="325" x2={p.x * 10} y2={p.y * 6.25} />
                  ))
                }
              </svg>

              <!-- Live background: radar, flight paths, drifting tokens, map symbols -->
              <div class="bg-layer" aria-hidden="true">
                <div class="radar-ring" style="width:220px;height:220px;"></div>
                <div class="radar-ring" style="width:380px;height:380px;"></div>
                <div class="radar"></div>
                <svg class="bg-paths" viewBox="0 0 1000 625" preserveAspectRatio="none">
                  <path d="M40 560 Q 260 430 480 520 T 930 470" />
                  <path d="M60 120 Q 300 40 520 130 T 960 90" />
                  <path d="M150 300 Q 420 240 640 330" />
                </svg>
                <span class="mover" style="left:38%;top:70%;"></span>
                <span class="mover" style="left:62%;top:20%;"></span>
                <span class="mover mover-b" style="left:22%;top:48%;"></span>
                <span class="pt" style="left:12%;top:40%;"></span>
                <span class="pt" style="left:33%;top:8%;animation-delay:-1s;"></span>
                <span class="pt" style="left:58%;top:86%;animation-delay:-2s;"></span>
                <span class="pt" style="left:88%;top:30%;animation-delay:-1.5s;"></span>
                <span class="pt" style="left:6%;top:88%;animation-delay:-2.5s;"></span>
                <span class="pt" style="left:94%;top:82%;animation-delay:-0.5s;"></span>
                <span class="pt" style="left:46%;top:44%;animation-delay:-1.8s;"></span>
                <span class="pt" style="left:80%;top:12%;animation-delay:-2.2s;"></span>
                <span class="tok" style="left:4%;top:24%;">−88% latency</span>
                <span class="tok alt" style="left:86%;top:54%;">+2.45%</span>
                <span class="tok warn" style="left:14%;top:70%;">~102 hrs / yr</span>
                <span class="tok" style="left:62%;top:6%;animation-delay:-3s;">{'{ }'}</span>
                <span class="tok alt" style="left:44%;top:92%;animation-delay:-5s;">=&gt;</span>
                <span class="tok" style="left:92%;top:40%;animation-delay:-6s;">+1.45% NE</span>
                <span class="tok warn" style="left:28%;top:34%;animation-delay:-2s;">−72% code</span>
                <span class="tok alt" style="left:70%;top:76%;animation-delay:-7s;">git push</span>
                <span class="tri" style="left:84%;top:86%;"></span>
                <span class="tri tri-s" style="left:88%;top:88%;"></span>
                <span class="net" style="left:52%;top:62%;"></span>
                <span class="brk" style="left:60%;top:48%;">&lt;/&gt;</span>
                <span class="brk" style="left:10%;top:56%;animation-delay:-4s;">{'{ }'}</span>
                <span class="ring" style="left:50%;top:20%;"></span>
                <span class="glyph" style="left:68%;top:44%;">{'{ }'}</span>
                <span class="glyph" style="left:80%;top:40%;animation-delay:-2s;">=&gt;</span>
                <span class="glyph" style="left:88%;top:48%;animation-delay:-3.5s;">#</span>
                <div class="compass"><div class="needle"></div></div>
                <div class="scan"></div>
              </div>

              <!-- Pin widgets: one live readout per section -->
              <div class="w w-research">
                <b>loss ↓ 11%</b> · genetic programming
                <svg class="wave-svg" viewBox="0 0 186 46" aria-hidden="true">
                  <path class="wave" d="M0 30 Q 23 6 46 24 T 93 18 T 140 22 T 186 8" />
                </svg>
              </div>
              <div class="w w-exp">
                <b>ranking · Ads models</b>
                <div class="rank rise"><span>orchestrator</span><span>−88% latency</span></div>
                <div class="rank"><span>feature swap</span><span>+1.45% NE</span></div>
                <div class="rank rise delay"><span>avg accuracy</span><span>+2.45%</span></div>
                <div class="agent-line">agent&gt; iterating<span class="blink">_</span></div>
              </div>
              <div class="w w-proj">
                <b>{projects[0]?.name}</b> · audit log
                <div class="code-line">bias_audit.run()<span class="blink">_</span></div>
              </div>
              <div class="w w-blog">
                <b>latest writing</b>
                <div class="clip">{posts[0]?.data.title}</div>
              </div>
              <div class="w w-beyond">
                <b>off the map</b>
                <div>volleyball · hiking</div>
                <div>hackathons · judging · mentoring</div>
              </div>

              {
                pins.map((p) => (
                  <a
                    class="pin"
                    href={`#${p.id}`}
                    data-pin={p.id}
                    data-pos={`${p.x},${p.y}`}
                    style={`left:${p.x}%;top:${p.y}%`}
                    aria-label={`Open ${p.label}`}
                  >
                    <span class="pin-dot"></span>
                    <span class="pin-label">{p.label}</span>
                  </a>
                ))
              }
            </div>

            <div class="zoom-controls">
              <button type="button" data-zoom-in aria-label="Zoom in">+</button>
              <button type="button" data-zoom-out aria-label="Zoom out">−</button>
              <button type="button" data-zoom-reset aria-label="Reset zoom">⤢</button>
            </div>

            <!-- Popup: section content, paged, on top of the map -->
            <div class="popup" data-popup hidden role="dialog" aria-modal="false" aria-labelledby="popup-title">
              <div class="popup-head">
                <span class="popup-title" id="popup-title" data-popup-title></span>
                <button class="back" type="button" data-close>close ✕</button>
              </div>
              <div class="popup-body">
                <div class="panel" data-panel="experience" data-title="git log --oneline experience" hidden>
                  <div class="photo-slot">[ photo: experience ]</div>
                  {
                    experience.map((e) => (
                      <div class="page" data-page>
                        <div class="role">{e.role} · {e.org}</div>
                        <div class="meta">{e.period}</div>
                        <p>{e.summary}</p>
                      </div>
                    ))
                  }
                  {
                    education.map((ed) => (
                      <div class="page" data-page>
                        <div class="role">{ed.role}</div>
                        <div class="meta">{ed.meta}</div>
                        <p>{ed.summary}</p>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="research" data-title="ls ./research" hidden>
                  <div class="photo-slot">[ photo: research ]</div>
                  {
                    research.map((r) => (
                      <div class="page" data-page>
                        <div class="role">{r.role} · {r.org}</div>
                        <div class="meta">{r.period}</div>
                        <p>{r.summary}</p>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="projects" data-title="ls ./projects" hidden>
                  <div class="photo-slot">[ photo: projects ]</div>
                  {
                    projects.map((p) => (
                      <div class="page" data-page>
                        <div class="role">{p.name}</div>
                        <div class="meta">{p.tags.join(' · ')}</div>
                        <p>{p.description}</p>
                        <div class="card-links">
                          {p.demo && p.demo !== '#' && <a href={p.demo}>Live</a>}
                          {p.repo && p.repo !== '#' && <a href={p.repo}>Code</a>}
                        </div>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="blog" data-title="tail -n 3 ./blog" hidden>
                  <div class="photo-slot">[ photo: blog ]</div>
                  {
                    posts.map((post) => (
                      <div class="page" data-page>
                        <div class="meta">
                          <time datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            })}
                          </time>
                        </div>
                        <div class="role"><a href={`/blog/${post.id}`}>{post.data.title}</a></div>
                        <p>{post.data.description}</p>
                      </div>
                    ))
                  }
                </div>

                <div class="panel" data-panel="beyond" data-title="ls ./beyond" hidden>
                  <div class="photo-slot">[ photo: beyond ]</div>
                  <div class="page" data-page>
                    <ul>
                      {beyond.map((b) => <li>{b}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
              <div class="popup-foot">
                <button type="button" data-prev>← prev</button>
                <span data-count>1 / 1</span>
                <button type="button" data-next>next →</button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Homepage only: widen the page and header to nearly full screen */
  :global(.site-header .container),
  .container {
    max-width: min(1600px, 96vw);
  }

  /* Desktop: the landing page fits the window with no scrolling */
  @media (min-width: 861px) {
    :global(html),
    :global(body) {
      height: 100%;
    }
    :global(body) {
      overflow: hidden;
    }
    .landing {
      height: calc(100dvh - 128px);
    }
  }

  /* Split landing: bio left, map right */
  .landing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 1.5rem;
    align-items: stretch;
    min-height: 0;
  }
  .bio-col {
    min-height: 0;
    overflow: hidden;
  }
  .bio-col .hero {
    padding: 2rem 0 0;
    border-bottom: none;
  }
  .bio-col .term-window {
    margin-top: 0;
  }
  .bio-col .term-body {
    padding: 1.25rem 1.5rem;
  }
  .bio-col .term-body p {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 0.6rem;
  }
  /* Bio column: compact so the whole terminal fits without clipping */
  .bio-col .term-bar {
    padding: 0.5rem 0.75rem;
  }
  .bio-col .term-body {
    padding: 1rem 1.25rem;
  }
  .bio-col .term-body .prompt {
    font-size: 0.8rem;
    margin: 0 0 0.15rem;
  }
  .bio-col .hero-head {
    margin-bottom: 0.5rem;
  }
  .bio-col .hero h1 {
    font-size: 1.6rem;
    margin: 0 0 0.2rem;
  }
  .bio-col .term-body .out-accent {
    font-size: 0.9rem;
    margin: 0;
  }
  .bio-col .term-body p {
    font-size: 0.85rem;
    line-height: 1.4;
    margin: 0 0 0.4rem;
  }
  .bio-col .socials {
    gap: 0.5rem;
  }
  .bio-col .icon-link {
    width: 32px;
    height: 32px;
  }
  .bio-col .icon-link svg {
    width: 16px;
    height: 16px;
  }
  .map-col {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .map-section {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 2rem 0 0;
    border-bottom: none;
  }
  .map-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
  }
  .map-canvas {
    position: absolute;
    inset: 0;
    transform-origin: var(--zx, 50%) var(--zy, 50%);
    transform: translate(var(--px, 0px), var(--py, 0px)) scale(var(--us, 1));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Pin zoom: at least 1.7x, from wherever the user has zoomed */
  .map-stage.is-zooming .map-canvas {
    transform: translate(var(--px, 0px), var(--py, 0px))
      scale(max(var(--us, 1), 1.7));
    transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .map-stage.is-dragging .map-canvas {
    transition: none;
  }
  .map-stage.can-pan {
    cursor: grab;
  }
  .map-stage.is-dragging {
    cursor: grabbing;
  }
  .zoom-controls {
    position: absolute;
    z-index: 6;
    right: 12px;
    bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .zoom-controls button {
    width: 36px;
    height: 36px;
    font-family: var(--mono);
    font-size: 16px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
  }
  .zoom-controls button:hover {
    border-color: var(--accent);
  }
  .zoom-controls button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .map-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map-svg :global(.grid-line) {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.5;
  }
  .map-svg :global(.land) {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 2;
  }
  .map-svg :global(.route) {
    stroke: var(--muted);
    stroke-width: 2;
    stroke-dasharray: 6 8;
    opacity: 0.6;
  }
  .back-bio {
    display: none;
    margin: 0 0 0.6rem;
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .back-bio:hover {
    border-color: var(--accent);
  }
  .landing.is-focus {
    grid-template-columns: minmax(0, 1fr);
  }
  .landing.is-focus .bio-col {
    display: none;
  }
  .landing.is-focus .back-bio {
    display: inline-block;
  }
  .cmd {
    font-family: var(--mono);
    font-size: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cmd:hover {
    color: var(--accent-hover);
  }
  .cmd:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Pins */
  .pin {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--text);
    font-family: var(--mono);
    text-decoration: none;
    cursor: pointer;
  }
  .pin:hover {
    color: var(--strong);
    text-decoration: none;
  }
  .pin:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 6px;
  }
  .pin-dot {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .pin-dot::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: pin-pulse 2.2s ease-out infinite;
  }
  .pin-label {
    font-size: 0.85rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }
  .pin.is-active .pin-dot {
    background: var(--strong);
  }
  .pin.is-active .pin-label {
    border-color: var(--accent);
    color: var(--accent);
  }
  @keyframes pin-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  /* Popup: section content shown over the map, one page at a time */
  .popup {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(600px, 92%);
    height: min(400px, 86%);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    font-family: var(--mono);
  }
  .popup[hidden] {
    display: none;
  }
  .popup.pop-in {
    animation: pop 0.35s ease both;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translate(-50%, -46%) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
  .popup-head,
  .popup-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.85rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  .popup-head {
    border-bottom: 1px solid var(--border);
  }
  .popup-foot {
    border-top: 1px solid var(--border);
  }
  .popup-title {
    color: var(--accent);
  }
  .popup-foot button {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .popup-foot button:hover:not(:disabled) {
    border-color: var(--accent);
  }
  .popup-foot button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .popup-foot button:focus-visible,
  .back:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .popup-body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
  }
  .panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .panel[hidden] {
    display: none;
  }
  .page {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    overflow: hidden;
  }
  .page[hidden] {
    display: none;
  }
  .page .role {
    font-weight: 600;
    color: var(--strong);
    line-height: 1.3;
  }
  .page .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .page p,
  .page li {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .page ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .popup .photo-slot {
    height: 60px;
    aspect-ratio: auto;
    margin: 0 0 0.6rem;
    flex-shrink: 0;
  }
  .back {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .back:hover {
    border-color: var(--accent);
  }
  /* Photo placeholder: replace the div with an <img> when pictures are ready */
  .photo-slot {
    border: 1px dashed var(--border);
    border-radius: 8px;
    aspect-ratio: 16 / 7;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }
  :global(html.js) .popup[hidden] {
    display: none;
  }
  .panel.panel-enter {
    animation: panel-in 0.5s ease both;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Live map background and pin widgets */
  .bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .bg-layer > * {
    position: absolute;
  }
  .radar-ring {
    left: 50%;
    top: 20%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px dashed var(--border);
  }
  .radar {
    left: 50%;
    top: 20%;
    width: 520px;
    height: 520px;
    margin: -260px 0 0 -260px;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      color-mix(in srgb, var(--accent) 14%, transparent) 0deg,
      transparent 60deg,
      transparent 360deg
    );
    animation: spin 8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .bg-paths {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bg-paths path {
    stroke: var(--border);
    stroke-width: 1.5;
    fill: none;
    stroke-dasharray: 4 6;
  }
  .mover {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--strong);
    box-shadow: 0 0 8px var(--accent);
    animation: mv 9s ease-in-out infinite alternate;
  }
  .mover-b {
    background: var(--muted);
  }
  @keyframes mv {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(120px, 40px);
    }
  }
  .pt {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--muted);
    animation: tw 3s ease-in-out infinite;
  }
  @keyframes tw {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.9;
    }
  }
  .tok,
  .glyph {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    opacity: 0.35;
    white-space: nowrap;
    animation: drift 14s ease-in-out infinite alternate;
  }
  .glyph {
    font-size: 10px;
    opacity: 0.5;
    animation: fall 5s linear infinite;
  }
  .tok.alt {
    color: var(--accent-hover);
  }
  .tok.warn {
    color: var(--warn);
  }
  @keyframes drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(18px, -22px);
    }
  }
  @keyframes fall {
    from {
      transform: translateY(-10px);
    }
    to {
      transform: translateY(60px);
    }
  }
  .brk {
    font-family: var(--mono);
    font-size: 16px;
    color: var(--muted);
    opacity: 0.4;
    animation: drift 10s ease-in-out infinite alternate;
  }
  .tri {
    width: 0;
    height: 0;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-bottom: 20px solid var(--border);
  }
  .tri-s {
    transform: scale(0.7);
  }
  .net {
    width: 120px;
    height: 2px;
    background: var(--border);
    transform: rotate(-4deg);
  }
  .scan {
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(
      transparent,
      color-mix(in srgb, var(--accent) 7%, transparent),
      transparent
    );
    animation: scan 7s linear infinite;
  }
  @keyframes scan {
    from {
      top: -80px;
    }
    to {
      top: 100%;
    }
  }
  .compass {
    right: 18px;
    top: 18px;
    width: 54px;
    height: 54px;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .compass::before {
    content: "N";
    position: absolute;
    top: 2px;
    color: var(--accent);
  }
  .needle {
    position: absolute;
    width: 2px;
    height: 22px;
    background: linear-gradient(var(--accent) 50%, var(--muted) 50%);
    animation: wobble 6s ease-in-out infinite alternate;
  }
  @keyframes wobble {
    from {
      transform: rotate(-12deg);
    }
    to {
      transform: rotate(14deg);
    }
  }
  .ring {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes ping {
    from {
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 1;
    }
    to {
      transform: translate(-50%, -50%) scale(1.8);
      opacity: 0;
    }
  }

  .w {
    position: absolute;
    z-index: 1;
    width: 220px;
    transform: translate(-50%, 0);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 10px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    pointer-events: none;
  }
  .w b {
    color: var(--accent);
    font-weight: 500;
  }
  .w-research {
    left: 50%;
    top: 32%;
    width: 200px;
    text-align: center;
  }
  .w-exp {
    left: 24%;
    top: 4%;
    width: 230px;
  }
  .w-proj {
    left: 76%;
    top: 52%;
  }
  .w-blog {
    left: 32%;
    top: 82%;
  }
  .w-beyond {
    left: 70%;
    top: 82%;
  }
  .wave-svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 6px;
  }
  .wave {
    stroke: var(--accent);
    stroke-width: 2;
    fill: none;
    stroke-dasharray: 200;
    animation: draw 3s linear infinite;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 200;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .rank {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--text);
    padding: 2px 0;
  }
  .rank.rise {
    animation: glow 4s ease-in-out infinite alternate;
  }
  .rank.delay {
    animation-delay: -2s;
  }
  /* Highlight instead of moving: rows stay in place and never overlap */
  @keyframes glow {
    from {
      color: var(--text);
    }
    to {
      color: var(--accent);
    }
  }
  .agent-line {
    margin-top: 6px;
    color: var(--warn);
  }
  .code-line {
    margin-top: 6px;
    color: var(--text);
  }
  .clip {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .blink {
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Phone: stacked, the map gets a fixed height and widgets are hidden */
  @media (max-width: 860px) {
    .landing {
      grid-template-columns: minmax(0, 1fr);
    }
    .map-stage {
      flex: none;
      height: 64vh;
      min-height: 420px;
    }
  }
  @media (max-width: 560px) {
    .w,
    .tok,
    .glyph {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-canvas {
      transition: none;
    }
    .bg-layer *,
    .w *,
    .rank,
    .wave,
    .pin-dot::after,
    .popup.pop-in,
    .panel.panel-enter {
      animation: none !important;
    }
  }

  /* Social icons */
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
  }
  .icon-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .icon-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .icon-link svg {
    width: 20px;
    height: 20px;
  }
</style>

<script>
  const root = document.documentElement;
  root.classList.add('js');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const landing = document.querySelector<HTMLElement>('[data-landing]');
  const stage = document.querySelector<HTMLElement>('[data-map-stage]');
  const canvas = document.querySelector<HTMLElement>('[data-map-canvas]');
  const popup = document.querySelector<HTMLElement>('[data-popup]');
  const popupTitle = document.querySelector<HTMLElement>('[data-popup-title]');
  const counter = document.querySelector<HTMLElement>('[data-count]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-next]');
  const pins = Array.from(document.querySelectorAll<HTMLElement>('[data-pin]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

  if (stage && canvas && popup && popupTitle && counter && prevBtn && nextBtn) {
    let busy = false;
    let current = '';
    let index = 0;

    const panelFor = (id: string) => panels.find((p) => p.dataset.panel === id);
    const pagesFor = (id: string) =>
      Array.from(panelFor(id)?.querySelectorAll<HTMLElement>('[data-page]') ?? []);

    function render() {
      const pages = pagesFor(current);
      pages.forEach((p, i) => {
        p.hidden = i !== index;
      });
      counter!.textContent = `${index + 1} / ${pages.length}`;
      prevBtn!.disabled = index === 0;
      nextBtn!.disabled = index >= pages.length - 1;
      pins.forEach((p) => p.classList.toggle('is-active', p.dataset.pin === current));
    }

    function openPopup(id: string) {
      const panel = panelFor(id);
      if (!panel) return;
      current = id;
      index = 0;
      panels.forEach((p) => (p.hidden = p !== panel));
      popupTitle!.textContent = panel.dataset.title ?? id;
      popup!.hidden = false;
      popup!.classList.remove('pop-in');
      void popup!.offsetWidth; // restart the entrance animation
      popup!.classList.add('pop-in');
      render();
    }

    function closePopup() {
      popup!.hidden = true;
      current = '';
      pins.forEach((p) => p.classList.remove('is-active'));
    }

    function step(d: number) {
      const n = pagesFor(current).length;
      index = Math.min(n - 1, Math.max(0, index + d));
      render();
    }

    function openFromPin(pin: HTMLElement) {
      if (busy) return;
      busy = true;
      const [x, y] = (pin.dataset.pos ?? '50,50').split(',');
      canvas!.style.setProperty('--zx', `${x}%`);
      canvas!.style.setProperty('--zy', `${y}%`);
      stage!.classList.add('is-zooming');
      const id = pin.dataset.pin ?? '';
      // Zoom toward the pin first, then open its popup.
      setTimeout(
        () => {
          stage!.classList.remove('is-zooming');
          openPopup(id);
          history.replaceState(null, '', `#${id}`);
          setTimeout(() => (busy = false), reduce ? 0 : 400);
        },
        reduce ? 0 : 650,
      );
    }

    pins.forEach((pin) =>
      pin.addEventListener('click', (e) => {
        e.preventDefault();
        openFromPin(pin);
      }),
    );

    popup.querySelector<HTMLElement>('[data-close]')?.addEventListener('click', () => {
      closePopup();
      history.replaceState(null, '', location.pathname);
    });
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));

    // Zoom and pan the map: buttons, mouse wheel, and drag while zoomed in
    const MIN_ZOOM = 1;
    const MAX_ZOOM = 3;
    let scale = 1;
    let panX = 0;
    let panY = 0;

    function applyView() {
      canvas!.style.setProperty('--us', String(scale));
      canvas!.style.setProperty('--px', `${panX}px`);
      canvas!.style.setProperty('--py', `${panY}px`);
      stage!.classList.toggle('can-pan', scale > MIN_ZOOM);
    }

    function clampPan() {
      const w = canvas!.offsetWidth;
      const h = canvas!.offsetHeight;
      const maxX = ((scale - 1) * w) / 2;
      const maxY = ((scale - 1) * h) / 2;
      panX = Math.min(maxX, Math.max(-maxX, panX));
      panY = Math.min(maxY, Math.max(-maxY, panY));
    }

    function zoomTo(next: number) {
      scale = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, next));
      canvas!.style.setProperty('--zx', '50%');
      canvas!.style.setProperty('--zy', '50%');
      if (scale === MIN_ZOOM) {
        panX = 0;
        panY = 0;
      }
      clampPan();
      applyView();
    }

    document.querySelector<HTMLElement>('[data-zoom-in]')?.addEventListener('click', () => zoomTo(scale * 1.25));
    document.querySelector<HTMLElement>('[data-zoom-out]')?.addEventListener('click', () => zoomTo(scale / 1.25));
    document.querySelector<HTMLElement>('[data-zoom-reset]')?.addEventListener('click', () => {
      panX = 0;
      panY = 0;
      zoomTo(MIN_ZOOM);
    });

    stage.addEventListener(
      'wheel',
      (e) => {
        if (busy) return;
        e.preventDefault();
        zoomTo(scale * (e.deltaY < 0 ? 1.12 : 1 / 1.12));
      },
      { passive: false },
    );

    let drag: { x: number; y: number; panX: number; panY: number; moved: boolean } | null = null;
    let suppressClick = false;

    stage.addEventListener('pointerdown', (e) => {
      if (busy || scale <= MIN_ZOOM) return;
      if ((e.target as HTMLElement).closest('.popup, .zoom-controls, .pin')) return;
      drag = { x: e.clientX, y: e.clientY, panX, panY, moved: false };
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 5) return;
      drag.moved = true;
      stage.classList.add('is-dragging');
      panX = drag.panX + dx;
      panY = drag.panY + dy;
      clampPan();
      applyView();
    });
    const endDrag = () => {
      if (!drag) return;
      suppressClick = drag.moved;
      drag = null;
      stage.classList.remove('is-dragging');
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
    // A drag that moved the map should not also count as a pin click
    stage.addEventListener(
      'click',
      (e) => {
        if (!suppressClick) return;
        suppressClick = false;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );

    // Arrow keys page through the popup; Escape closes it.
    document.addEventListener('keydown', (e) => {
      if (popup.hidden) return;
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'Escape') closePopup();
    });

    // Back to bio: leave focus mode and close any popup.
    document.querySelector<HTMLElement>('[data-back-bio]')?.addEventListener('click', () => {
      landing?.classList.remove('is-focus');
      closePopup();
      history.replaceState(null, '', location.pathname);
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });

    // "explore ./map": full-screen map with no popup open.
    document.querySelector<HTMLElement>('[data-explore]')?.addEventListener('click', () => {
      closePopup();
      landing?.classList.add('is-focus');
      history.replaceState(null, '', '#map');
    });

    // Deep links (#research) and header nav clicks open the matching popup.
    function fromHash() {
      const id = location.hash.slice(1);
      if (id && panelFor(id)) openPopup(id);
    }
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>
