---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// ---- Edit your content here -------------------------------------------------
const projects = [
  {
    name: 'Probe Layer',
    description:
      'A bias-audit platform with a public audit page, per-submission audit log, JSON API, and a browser extension.',
    tags: ['TypeScript', 'Web', 'Browser Extension'],
    demo: '#',
    repo: '#',
  },
  {
    name: 'Project Two',
    description: 'Short, punchy description of what it does and why it matters.',
    tags: ['Python', 'API'],
    demo: '#',
    repo: '#',
  },
  {
    name: 'Project Three',
    description: 'Another highlight. Keep it to one or two sentences.',
    tags: ['React'],
    demo: '#',
    repo: '#',
  },
];

const experience = [
  {
    role: 'Co-Founder & CTO',
    org: 'Stealth Startup',
    period: 'Mar 2026 — Present',
    summary:
      'Building an AI-native LMS for AI-assisted curriculum building, teaching, assessment, and grading; benchmarking 10+ models for grading quality.',
  },
  {
    role: 'Software Engineer, ML Infrastructure',
    org: 'Meta',
    period: 'Feb 2025 — Present',
    summary:
      'Build ML workflow orchestration for Ads ranking — cut model-iteration latency ~88% and drove avg 2.45% accuracy gains across production models.',
  },
  {
    role: 'Software Engineer Intern',
    org: 'HPE — Juniper Networking',
    period: 'May 2024 — Aug 2024',
    summary:
      'Rewrote a Python microservice (−72% code) and migrated Address Pool Manager monitoring to Prometheus/Grafana with custom gRPC metrics endpoints on Kubernetes.',
  },
  {
    role: 'Software Developer',
    org: 'Hamilton College R&ID Team',
    period: 'Jun 2023 — Jan 2024',
    summary:
      'Built an inventory app on AWS (DynamoDB, S3, Lambda) behind a Django REST API, and revamped a 7-page digital archive in React.',
  },
];

const research = [
  {
    role: 'ML Research Assistant',
    org: 'Hamilton College CS Department',
    period: 'May 2022 — Aug 2022',
    summary:
      'Fine-tuned a Clojure genetic-programming model (−11% training cases) and automated HPC experiment runs with results visualization.',
  },
];
// -----------------------------------------------------------------------------

// Latest 3 blog posts, newest first
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title="Ahmed Abdelrehim">
  <div class="container">
    <!-- Hero + About -->
    <section class="hero" id="about">
      <div class="term-window">
        <div class="term-bar">
          <i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i>
          <span class="title">aabdelre — zsh</span>
        </div>
        <div class="term-body">
          <p class="prompt">whoami</p>
          <div class="hero-head">
            <img
              class="avatar"
              src="/personalPic.jpeg"
              alt="Ahmed Abdelrehim"
              width="120"
              height="120"
            />
            <div>
              <h1>Ahmed Abdelrehim</h1>
              <p class="out-accent">
                AI/ML enthusiast. Aspiring disrupter.
              </p>
            </div>
          </div>
          <p class="prompt">cat about.txt</p>
          <p>
            I'm a software and machine learning engineer at Meta, where I build
            the systems that train and improve the models deciding which ads
            people see. I work on the models themselves, testing which
            techniques actually help and building tools that make that testing
            faster and more reliable.
          </p>
          <p>
            I love explaining things, and I learn best by building. That's why
            I'm now co-founding an AI startup that helps teachers design
            courses, give feedback, and grade work, with people in the loop at
            every step. I want to bring what I've learned about getting ML to
            work reliably at scale into the classroom, where getting it right
            matters just as much.
          </p>
          <p class="prompt">open links</p>
          <div class="socials">
            <a href="https://github.com/aabdelre">github</a>
            <a href="https://www.linkedin.com/in/aash2024/">linkedin</a>
            <a href="mailto:aabdelre.ahmed@gmail.com">email</a>
            <a href="/resume.pdf">resume.pdf</a>
          </div>
          <p class="prompt" style="margin-top: 1.5rem"><span class="caret"></span></p>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section id="education">
      <p class="section-title">cat ./education</p>
      <div class="timeline">
        <div class="timeline-item">
          <div class="role">B.A., Computer Science &amp; Mathematics · Hamilton College</div>
          <div class="meta">Clinton, NY · Dec 2024 · GPA 3.88</div>
          <p>
            Magna Cum Laude · CS Honors · Phi Beta Kappa · Dean's List (every
            semester)
          </p>
        </div>
        <div class="timeline-item">
          <div class="role">Study Abroad · The University of Manchester</div>
          <div class="meta">Manchester, UK · Jan 2023 — Jan 2024 · Merit-based</div>
          <p>Year abroad awarded for merit.</p>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <p class="section-title">git log --oneline experience</p>
      <div class="timeline">
        {
          experience.map((e) => (
            <div class="timeline-item">
              <div class="role">
                {e.role} · {e.org}
              </div>
              <div class="meta">{e.period}</div>
              <p>{e.summary}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Research -->
    <section id="research">
      <p class="section-title">ls ./research</p>
      <div class="timeline">
        {
          research.map((r) => (
            <div class="timeline-item">
              <div class="role">
                {r.role} · {r.org}
              </div>
              <div class="meta">{r.period}</div>
              <p>{r.summary}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <p class="section-title">ls ./projects</p>
      <div class="cards">
        {
          projects.map((p) => (
            <article class="card">
              <h3>{p.name}</h3>
              <div class="tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <p>{p.description}</p>
              <div class="card-links">
                {p.demo && p.demo !== '#' && <a href={p.demo}>Live</a>}
                {p.repo && p.repo !== '#' && <a href={p.repo}>Code</a>}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Latest writing -->
    <section id="writing">
      <p class="section-title">tail -n 3 ./writing</p>
      <ul class="post-list">
        {
          posts.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </li>
          ))
        }
      </ul>
      <p style="margin-top:1rem"><a href="/blog">All posts →</a></p>
    </section>
  </div>
</Base>
