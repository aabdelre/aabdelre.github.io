  .map-svg :global(.land) {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 2;
  }
  .route-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .route-svg :global(.route) {
    stroke: var(--muted);
    stroke-width: 2;
    stroke-dasharray: 6 8;
    opacity: 0.6;
    vector-effect: non-scaling-stroke;
  }
  .back-bio {
    display: none;
    margin: 0 0 0.6rem;
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .back-bio:hover {
    border-color: var(--accent);
  }
  .landing.is-focus {
    grid-template-columns: minmax(0, 1fr);
  }
  .landing.is-focus .bio-col {
    display: none;
  }
  .landing.is-focus .back-bio {
    display: inline-block;
  }
  .cmd {
    font-family: var(--mono);
    font-size: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cmd:hover {
    color: var(--accent-hover);
  }
  .cmd:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Pins */
  .pin {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--text);
    font-family: var(--mono);
    text-decoration: none;
    cursor: pointer;
  }
  .pin:hover {
    color: var(--strong);
    text-decoration: none;
  }
  .pin:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 6px;
  }
  .pin-dot {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .pin-dot::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: pin-pulse 2.2s ease-out infinite;
  }
  .pin-label {
    font-size: 0.85rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }
  .pin-num {
    color: var(--accent);
    margin-right: 0.3rem;
  }
  .pin.is-active .pin-dot {
    background: var(--strong);
  }
  .pin.is-active .pin-label {
    border-color: var(--accent);
    color: var(--accent);
  }
  @keyframes pin-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  /* Popup: section content shown over the map, one page at a time */
  .popup {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(600px, 92%);
    height: min(400px, 86%);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    font-family: var(--mono);
  }
  .popup[hidden] {
    display: none;
  }
  /* Takeover: the section fills the whole map and grows out of the pin that opened it */
  .popup {
    --ox: 50%;
    --oy: 50%;
  }
  .popup.takeover {
    inset: 0;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .popup.takeover .popup-head {
    padding: 1rem 1.75rem;
    font-size: 1rem;
  }
  .popup.takeover .popup-foot {
    padding: 1rem 1.75rem;
  }
  .popup.takeover .popup-body {
    padding: 1.25rem 2rem;
  }
  .popup.takeover .page .role {
    font-size: 1.5rem;
  }
  .popup.takeover .page p,
  .popup.takeover .page li {
    font-size: 1.15rem;
    line-height: 1.7;
  }
  .popup.grow {
    animation: grow-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    transform-origin: var(--ox) var(--oy);
  }
  @keyframes grow-in {
    from {
      opacity: 0;
      transform: scale(0.12);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  .popup.shrink {
    animation: shrink-out 0.35s ease-in both;
    transform-origin: var(--ox) var(--oy);
  }
  @keyframes shrink-out {
    to {
      opacity: 0;
      transform: scale(0.12);
    }
  }
  .map-stage:has(.popup.takeover) .zoom-controls {
    display: none;
  }
  .popup.pop-in {
    animation: pop 0.35s ease both;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translate(-50%, -46%) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
  .popup-head,
  .popup-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.85rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  .popup-head {
    border-bottom: 1px solid var(--border);
  }
  .popup-foot {
    border-top: 1px solid var(--border);
  }
  .popup-title {
    color: var(--accent);
  }
  .popup-foot button {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .popup-foot button:hover:not(:disabled) {
    border-color: var(--accent);
  }
  .popup-foot button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .popup-foot button:focus-visible,
  .back:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .popup-body {
    flex: 1;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
  }
  .panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .panel[hidden] {
    display: none;
  }
  .page {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    overflow: hidden;
  }
  .page[hidden] {
    display: none;
  }
  .page .role {
    font-weight: 600;
    color: var(--strong);
    line-height: 1.3;
  }
  .page .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .page p,
  .page li {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .page ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .popup .photo-slot {
    height: 60px;
    aspect-ratio: auto;
    margin: 0 0 0.6rem;
    flex-shrink: 0;
  }
  .back {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .back:hover {
    border-color: var(--accent);
  }
  /* Photo placeholder: replace the div with an <img> when pictures are ready */
  .photo-slot {
    border: 1px dashed var(--border);
    border-radius: 8px;
    aspect-ratio: 16 / 7;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }
  :global(html.js) .popup[hidden] {
    display: none;
  }
  .panel.panel-enter {
    animation: panel-in 0.5s ease both;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Live map background and pin widgets */
  .bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .bg-layer > * {
    position: absolute;
  }
  .radar-ring {
    left: 50%;
    top: 20%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px dashed var(--border);
  }
  .radar {
    left: 50%;
    top: 20%;
    width: 520px;
    height: 520px;
    margin: -260px 0 0 -260px;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      color-mix(in srgb, var(--accent) 14%, transparent) 0deg,
      transparent 60deg,
      transparent 360deg
    );
    animation: spin 8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .bg-paths {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bg-paths path {
    stroke: var(--border);
    stroke-width: 1.5;
    fill: none;
    stroke-dasharray: 4 6;
  }
  .mover {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--strong);
    box-shadow: 0 0 8px var(--accent);
    animation: mv 9s ease-in-out infinite alternate;
  }
  .mover-b {
    background: var(--muted);
  }
  @keyframes mv {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(120px, 40px);
    }
  }
  .pt {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--muted);
    animation: tw 3s ease-in-out infinite;
  }
  @keyframes tw {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.9;
    }
  }
  .tok,
  .glyph {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    opacity: 0.35;
    white-space: nowrap;
    animation: drift 14s ease-in-out infinite alternate;
  }
  .glyph {
    font-size: 10px;
    opacity: 0.5;
    animation: fall 5s linear infinite;
  }
  .tok.alt {
    color: var(--accent-hover);
  }
  .tok.warn {
    color: var(--warn);
  }
  @keyframes drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(18px, -22px);
    }
  }
  @keyframes fall {
    from {
      transform: translateY(-10px);
    }
    to {
      transform: translateY(60px);
    }
  }
  .brk {
    font-family: var(--mono);
    font-size: 16px;
    color: var(--muted);
    opacity: 0.4;
    animation: drift 10s ease-in-out infinite alternate;
  }
  .tri {
    width: 0;
    height: 0;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-bottom: 20px solid var(--border);
  }
  .tri-s {
    transform: scale(0.7);
  }
  .scan {
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(
      transparent,
      color-mix(in srgb, var(--accent) 7%, transparent),
      transparent
    );
    animation: scan 7s linear infinite;
  }
  @keyframes scan {
    from {
      top: -80px;
    }
    to {
      top: 100%;
    }
  }
  .compass {
    right: 18px;
    top: 18px;
    width: 54px;
    height: 54px;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .compass::before {
    content: "N";
    position: absolute;
    top: 2px;
    color: var(--accent);
  }
  .needle {
    position: absolute;
    width: 2px;
    height: 22px;
    background: linear-gradient(var(--accent) 50%, var(--muted) 50%);
    animation: wobble 6s ease-in-out infinite alternate;
  }
  @keyframes wobble {
    from {
      transform: rotate(-12deg);
    }
    to {
      transform: rotate(14deg);
    }
  }
  .ring {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes ping {
    from {
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 1;
    }
    to {
      transform: translate(-50%, -50%) scale(1.8);
      opacity: 0;
    }
  }

  .w {
    position: absolute;
    z-index: 1;
    width: 220px;
    transform: translate(-50%, 0);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 10px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    pointer-events: none;
  }
  .w b {
    color: var(--accent);
    font-weight: 500;
  }
  .w-research {
    left: 74%;
    top: 9%;
    width: 170px;
    text-align: center;
  }
  .w-exp {
    left: 24%;
    top: 4%;
    width: 230px;
  }
  .w-proj {
    left: 76%;
    top: 52%;
  }
  .w-blog {
    left: 32%;
    top: 82%;
  }
  .w-beyond {
    left: 70%;
    top: 82%;
  }
  .wave-svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 6px;
  }
  .wave {
    stroke: var(--accent);
    stroke-width: 2;
    fill: none;
    stroke-dasharray: 200;
    animation: draw 3s linear infinite;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 200;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .rank {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--text);
    padding: 2px 0;
  }
  .rank.rise {
    animation: glow 4s ease-in-out infinite alternate;
  }
  .rank.delay {
    animation-delay: -2s;
  }
  /* Highlight instead of moving: rows stay in place and never overlap */
  @keyframes glow {
    from {
      color: var(--text);
    }
    to {
      color: var(--accent);
    }
  }
  .agent-line {
    margin-top: 6px;
    color: var(--warn);
  }
  .code-line {
    margin-top: 6px;
    color: var(--text);
  }
  .clip {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .blink {
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Terminal-window frames around photos */
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
  }
  .shot-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.4rem 0.7rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  .shot-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  .shot-bar .dot-r { background: #ff5f56; }
  .shot-bar .dot-y { background: #ffbd2e; }
  .shot-bar .dot-g { background: #27c93f; }
  .shot-bar span {
    margin-left: 0.5rem;
    color: var(--accent);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .split-text .shot {
    height: clamp(220px, 42vh, 400px);
  }
  .split-imgs .shot {
    flex: 1;
    min-height: 0;
  }
  /* Hiking: two photos per row, so the waterfall and overlook sit side by side */
  /* Hackathons: two photos on top, the last one full width below */
  .split-imgs.split-hack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    gap: 0.75rem;
    align-items: stretch;
  }
  .split-imgs.split-hack .shot {
    min-width: 0;
    min-height: 0;
    flex: none;
    height: auto;
  }
  .split-imgs.split-hack .shot:last-child {
    grid-column: 1 / -1;
  }
  .split-imgs.split-hack .shot {
    height: clamp(150px, 20vh, 200px);
  }
  .split-imgs.split-hack .shot:last-child {
    height: auto;
    min-height: 0;
  }
  .split-imgs.split-hack .shot:last-child img {
    flex: 1 1 0;
    width: 100%;
    height: 0;
    min-height: 0;
    object-fit: contain;
  }
  .split-imgs.split-hack .shot img {
    flex: 1 1 0;
    height: 0;
    width: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .split-pair {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.75rem;
  }
  .split-pair .shot {
    flex: 1 1 calc(50% - 0.375rem);
    min-width: 0;
    background: var(--surface);
  }
  .split-pair .shot img {
    height: auto;
    max-height: 220px;
    background: var(--surface);
  }
  /* Zion is centred vertically inside its frame */
  .split-pair .shot img[src$="zion.jpg"] {
    margin-top: auto;
    margin-bottom: auto;
  }
  .split-grid .shot {
    min-height: 0;
  }
  .split-grid .shot:has(video) {
    grid-column: 1 / -1;
    grid-row: 1;
  }
  .shot video {
    display: block;
    width: 100%;
    height: calc(100% - 2rem);
    min-height: 0;
    object-fit: contain;
    background: var(--surface);
  }
  .shot img {
    display: block;
    width: 100%;
    height: calc(100% - 2rem);
    min-height: 0;
    object-fit: contain;
    background: var(--surface);
    border: 0;
    border-radius: 0;
  }

  /* Two-page spread: text and one photo on the left, the rest on the right */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    flex: 1;
    min-height: 0;
    margin-top: 0.4rem;
  }
  .split-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
  }
  .split-text img {
    width: 100%;
    height: clamp(200px, 40vh, 380px);
    object-fit: contain;
    background: var(--surface);
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .split-imgs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
  }
  /* Volleyball only: the video fills the top half, the two photos sit side by side below */
  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
  }
  .split-imgs img {
    flex: 1;
    min-height: 0;
    width: 100%;
    object-fit: contain;
    background: var(--surface);
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  @media (max-width: 560px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  /* Photo rows inside a section page */
  .img-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 0.4rem;
  }
  .img-row img {
    width: 100%;
    height: clamp(180px, 34vh, 340px);
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  @media (max-width: 560px) {
    .img-row {
      grid-template-columns: 1fr;
    }
    .img-row img {
      height: 200px;
    }
  }

  .hand {
    position: absolute;
    z-index: 2;
    font-family: "Caveat", cursive;
    font-size: 1.35rem;
    color: var(--warn);
    pointer-events: none;
    transform: rotate(-3deg);
    white-space: nowrap;
  }
  .hand-1 {
    left: 2.5%;
    top: 2%;
    color: var(--accent);
  }
  .hand-2 {
    left: 45%;
    top: 47%;
    color: var(--warn);
    transform: rotate(-2deg);
  }
  .hand-3 {
    left: 45%;
    top: 84%;
    color: #58a6ff;
  }
  .hand-4 {
    right: 2%;
    bottom: 2%;
    font-size: 1.1rem;
    color: var(--muted);
    transform: none;
  }

  /* Lab notebook view for one research entry */
  .nb {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
    font-family: var(--mono);
  }
  .nb-side {
    border-right: 1px solid var(--border);
    padding: 1rem;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-height: 0;
    overflow-y: auto;
  }
  .nb-ls {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .nb-item {
    text-align: left;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    border: 1px solid transparent;
    background: none;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .nb-item small {
    font-size: 0.7rem;
    color: var(--muted);
    opacity: 0.8;
  }
  .nb-item.on {
    color: var(--strong);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .nb-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .nb-main {
    padding: 1.4rem 1.8rem;
    overflow: hidden;
    background-image: linear-gradient(color-mix(in srgb, var(--border) 45%, transparent) 1px, transparent 1px);
    background-size: 100% 28px;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 0;
  }
  .nb-title {
    font-size: 1.5rem;
    color: var(--strong);
    line-height: 1.25;
  }
  .nb-question {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--accent);
    margin-top: -0.5rem;
  }
  .nb-meta {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .nb-cell {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 0.9rem 1.1rem;
  }
  .nb-head {
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .nb-cell p {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }
  .nb-cell a {
    color: var(--accent);
  }
  .nb-links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.95rem;
  }
  .nb-links li {
    padding: 0.35rem 0.6rem;
    border: 1px dashed var(--border);
    border-radius: 6px;
  }
  @media (max-width: 560px) {
    .nb {
      grid-template-columns: 1fr;
    }
    .nb-side {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }

  /* About: photo placeholder and education entries */
  /* One row, with each prompt sitting over the content it labels */
  .ab-top {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
  }
  .ab-top .about-cap {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }
  .ab-top .ab-prompt {
    grid-column: 2;
    grid-row: 1;
  }
  @media (max-width: 560px) {
    .ab-top {
      grid-template-columns: 1fr;
    }
    .ab-top .about-cap,
    .ab-top .ab-prompt {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
    }
  }
  .ab-wide {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 1rem 1.5rem;
    align-items: center;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .about-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    width: 100%;
  }
  .about-photo-wrap {
    width: 100%;
    max-width: 200px;
    padding: 6px;
    border-radius: 50%;
    background: conic-gradient(var(--accent), var(--border) 35%, var(--accent) 70%, var(--border));
  }
  .about-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0;
    object-fit: cover;
    object-position: center 30%;
  }
  .ab-dollar {
    color: var(--accent);
  }
  .about-cap {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .ab-prompt {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ab-prompt::before {
    content: "$ ";
    color: var(--accent);
  }
  .ab-gap {
    margin-top: 0.4rem;
  }
  .ab-title {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--strong);
    margin: 0.2rem 0 0.4rem;
  }
  .ab-intro {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--text);
    margin: 0;
  }
  .ab-intro b {
    color: var(--accent);
    font-weight: 600;
  }
  .ab-box {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    background: var(--surface);
    padding: 0.6rem 0.9rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }
  .ab-edu {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.6rem;
  }
  .ab-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    padding: 0.6rem 0.9rem;
  }
  .ab-card h4 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
    color: var(--strong);
  }
  .ab-meta {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .chip {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    margin: 0.5rem 0.35rem 0 0;
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
  }
  .about-text p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text);
  }
  .about-sub {
    margin-top: 0.6rem;
  }
  @media (max-width: 560px) {
    .about-body {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .about-text {
      width: 100%;
    }
  }
  .edu {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.9rem;
  }

  /* Experience as a git log */
  .log {
    display: flex;
    flex-direction: column;
    font-family: var(--mono);
    padding: 0.5rem 0;
  }
  .log[hidden] {
    display: none;
  }
  .commit {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    text-align: left;
    background: none;
    border: 0;
    border-left: 2px solid var(--border);
    margin-left: 0.5rem;
    padding: 0.8rem 1rem 0.8rem 1.2rem;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.95rem;
    cursor: pointer;
  }
  .commit::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-50%);
  }
  .commit:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .commit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .commit .hash {
    color: var(--warn);
  }
  .commit .head {
    margin-left: 0.6rem;
    padding: 0 0.45rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.7rem;
  }
  .commit .when {
    color: var(--muted);
    font-size: 0.85rem;
    text-align: right;
  }
  .commit-view {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .commit-view[hidden] {
    display: none;
  }
  .commit-view .back {
    align-self: flex-start;
  }
  .cv-hash {
    font-family: var(--mono);
    color: var(--warn);
  }
  .cv-msg {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--strong);
  }
  .cv-when {
    font-family: var(--mono);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .cv-imgs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .cv-text {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }
  .cv-stack {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .cv-beside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  .cv-beside .cv-imgs {
    grid-template-columns: minmax(0, 1fr);
  }
  .cv-beside .cv-imgs .shot img {
    height: clamp(180px, 34vh, 300px);
  }
  @media (max-width: 560px) {
    .cv-beside {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cv-imgs .shot img {
    width: 100%;
    height: clamp(160px, 28vh, 240px);
    object-fit: contain;
    background: var(--surface);
    border: 0;
    border-radius: 0;
  }
  .cv-list {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text);
  }
  .commit-view {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }
  .commit-view p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text);
  }

  /* Research as a whiteboard */
  .board {
    position: relative;
    flex: 1;
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background-color: var(--bg);
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 26px 26px;
    overflow: hidden;
  }
  .board[hidden] {
    display: none;
  }
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .wires path {
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
    fill: none;
    vector-effect: non-scaling-stroke;
    opacity: 0.6;
  }
  .rcard {
    position: absolute;
    width: 27%;
    min-height: 28%;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem 1rem;
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    color: var(--text);
    font-family: var(--mono);
  }
  .rcard:hover,
  .rcard:focus-visible {
    border-color: var(--accent);
    outline: none;
  }
  .rbar {
    display: block;
    height: 4px;
    border-radius: 2px;
    margin-bottom: 0.3rem;
  }
  .rtitle {
    font-size: 0.95rem;
    color: var(--strong);
    line-height: 1.3;
  }
  .rsub {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .rnote {
    position: absolute;
    right: 1rem;
    bottom: 0.7rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .rdetail {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .rdetail[hidden] {
    display: none;
  }
  .rdetail .role {
    font-weight: 600;
    color: var(--strong);
    font-size: 1.4rem;
  }
  .rdetail .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .rdetail p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text);
  }
  .rdetail .back {
    align-self: flex-start;
  }

  /* Projects as a desktop: an opened project is a window on the right */
  .panel {
    position: relative;
  }
  .win-frame {
    width: 100%;
    height: 640px;
    border: 0;
    border-radius: 10px;
    background: var(--bg);
  }
  .panel.win-open .desk {
    width: 40%;
  }
  .project-win {
    position: absolute;
    right: 0.5rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: min(600px, 54%);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    overflow-x: hidden;
    overflow-y: auto;
    z-index: 3;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .project-win[hidden] {
    display: none;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.8rem;
    flex-shrink: 0;
  }
  .win-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  .win-bar .dot-r { background: #ff5f56; }
  .win-bar .dot-y { background: #ffbd2e; }
  .win-bar .dot-g { background: #27c93f; }
  .win-title {
    margin-left: 0.5rem;
    color: var(--accent);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .win-close {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    width: 26px;
    height: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .win-close:hover {
    border-color: var(--accent);
  }
  .win-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .project-win > :not(.win-bar) {
    margin: 0 1.1rem;
  }
  .project-win .fun-fact {
    font-size: 0.9rem;
    color: var(--muted);
    font-style: italic;
  }
  /* Menu Thumbnails Builder: the two app mocks, side by side, scaled to fit the window */
  .mk-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .mk-phone {
    width: 228px;
    height: 494px;
    overflow: hidden;
    border-radius: 26px;
    border: 6px solid #1c1c1e;
    background: #f2f2f7;
    box-sizing: content-box;
    position: relative;
    flex-shrink: 0;
  }
  .mk-screen {
    width: 390px;
    height: 844px;
    transform: scale(0.5);
    transform-origin: top left;
    display: flex;
    flex-direction: column;
    background: #f2f2f7;
    color: #000;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
    padding: 54px 20px 0;
    box-sizing: border-box;
  }
  .mk-big { font-size: 34px; font-weight: 700; margin: 8px 0 16px; }
  .mk-drop { background: #fff; border-radius: 14px; height: 170px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; text-align: center; }
  .mk-icon { font-size: 34px; color: #007aff; }
  .mk-drop b { font-size: 17px; font-weight: 600; }
  .mk-drop small { font-size: 13px; color: #8e8e93; padding: 0 24px; }
  .mk-section { font-size: 17px; font-weight: 600; margin: 22px 4px 8px; }
  .mk-list { background: #fff; border-radius: 14px; overflow: hidden; }
  .mk-row-item { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 11px 14px; border-bottom: 1px solid #d1d1d6; }
  .mk-row-item:last-child { border-bottom: 0; }
  .mk-name { font-size: 17px; }
  .mk-ing { font-size: 13px; color: #8e8e93; margin-top: 2px; }
  .mk-thumb { width: 52px; height: 52px; border-radius: 10px; background: #e5e5ea; color: #8e8e93; display: grid; place-items: center; flex-shrink: 0; font-size: 22px; }
  .mk-footer { margin-top: auto; display: flex; gap: 12px; padding: 0 0 36px; }
  .mk-btn { flex: 1; padding: 14px 0; border-radius: 12px; font-size: 17px; font-weight: 600; text-align: center; }
  .mk-bordered { background: #e5e5ea; color: #007aff; }
  .mk-prominent { background: #007aff; color: #fff; }
  .mk-nav { display: flex; justify-content: space-between; align-items: center; padding: 0 0 12px; }
  .mk-t { font-size: 17px; font-weight: 600; flex: 1; text-align: center; }
  .mk-link { color: #007aff; font-size: 17px; }
  .mk-heading { font-size: 28px; font-weight: 700; }
  .mk-sub { font-size: 13px; color: #8e8e93; margin: 4px 0 14px; }
  .mk-card { background: #fff; border-radius: 14px; overflow: hidden; margin-bottom: 14px; }
  .mk-pic { height: 130px; background: linear-gradient(135deg, #e5e5ea, #f2f2f7); display: grid; place-items: center; font-size: 13px; color: #8e8e93; }
  .mk-meta { padding: 12px 14px 14px; }
  .mk-meta .mk-name { font-size: 17px; font-weight: 600; }
  .mk-tag { display: inline-block; font-size: 11px; color: #8e8e93; background: #e5e5ea; border-radius: 999px; padding: 3px 9px; margin: 8px 6px 0 0; }
  .mk-bottom { margin-top: auto; padding: 12px 0 36px; }
  .mk-bottom .mk-btn { width: 100%; box-sizing: border-box; }
  .win-media.mk-frame {
    aspect-ratio: auto;
    height: auto;
    display: block;
    padding: 0;
    overflow: visible;
  }
  .mk-frame img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  .win-media {
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--border);
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .project-win .role {
    font-weight: 600;
    color: var(--strong);
    font-size: 1.2rem;
    margin-top: 0.5rem;
  }
  .project-win .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .project-win p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }
  .project-win .card-links {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
  }

  /* Blog window: the latest posts in one list */
  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .blog-list li .role a {
    color: var(--strong);
  }
  .blog-all {
    margin: 0;
  }
  /* ahmed.os label in the footer of the projects view */
  .foot-os {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .foot-os[hidden] {
    display: none;
  }
  .foot-time {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .foot-time[hidden] {
    display: none;
  }

  /* Projects as a desktop of folders */
  .desk {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 1rem;
    align-content: start;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .desk[hidden] {
    display: none;
  }
  .folder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.4rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    background: none;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    user-select: none;
  }
  .folder:hover {
    border-color: var(--border);
  }
  .folder.is-selected {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-color: var(--accent);
  }
  .folder:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .folder-icon {
    width: 56px;
    height: 46px;
    color: var(--accent);
  }
  .folder-name {
    text-align: center;
    word-break: break-word;
  }
  .project-win {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .project-win[hidden] {
    display: none;
  }
  .project-win .back {
    align-self: flex-start;
  }
  .project-win .role {
    font-weight: 600;
    color: var(--strong);
    font-size: 1.1rem;
  }
  .project-win .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .project-win p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .project-win .card-links {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
  }

  /* Transitions into and out of the full-screen map */
  .bio-col {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .bio-col.is-leaving {
    opacity: 0;
    transform: translateX(-24px);
  }
  .bio-col.bio-in {
    animation: bio-in 0.6s ease both;
  }
  @keyframes bio-in {
    from {
      opacity: 0;
      transform: translateX(-16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .map-stage.enter {
    animation: map-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes map-in {
    from {
      opacity: 0;
      transform: scale(0.55);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }
  .map-stage.exit {
    animation: map-out 0.5s ease-in both;
  }
  @keyframes map-out {
    to {
      opacity: 0;
      transform: scale(0.55);
      filter: blur(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bio-col,
    .bio-col.is-leaving,
    .map-stage.enter,
    .map-stage.exit,
    .bio-col.bio-in {
      animation: none !important;
      transition: none !important;
    }
  }

  /* Phone: stacked, the map gets a fixed height and widgets are hidden */
  @media (max-width: 860px) {
    .landing {
      grid-template-columns: minmax(0, 1fr);
    }
    .map-stage {
      flex: none;
      height: 64vh;
      min-height: 420px;
    }
  }
  @media (max-width: 560px) {
    .w,
    .tok,
    .glyph {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-canvas {
      transition: none;
    }
    .bg-layer *,
    .w *,
    .rank,
    .wave,
    .pin-dot::after,
    .popup.pop-in,
    .panel.panel-enter {
      animation: none !important;
    }
  }

  /* Social icons */
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
  }
  .icon-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .icon-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .icon-link svg {
    width: 20px;
    height: 20px;
  }
</style>

<script>
  const root = document.documentElement;
  root.classList.add('js');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const landing = document.querySelector<HTMLElement>('[data-landing]');
  const stage = document.querySelector<HTMLElement>('[data-map-stage]');
  const canvas = document.querySelector<HTMLElement>('[data-map-canvas]');
  const popup = document.querySelector<HTMLElement>('[data-popup]');
  const popupTitle = document.querySelector<HTMLElement>('[data-popup-title]');
  const counter = document.querySelector<HTMLElement>('[data-count]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-next]');
  const pins = Array.from(document.querySelectorAll<HTMLElement>('[data-pin]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

  if (stage && canvas && popup && popupTitle && counter && prevBtn && nextBtn) {
    let busy = false;
    let current = '';
    let index = 0;

    const panelFor = (id: string) => panels.find((p) => p.dataset.panel === id);
    const pagesFor = (id: string) =>
      Array.from(panelFor(id)?.querySelectorAll<HTMLElement>('[data-page]') ?? []);

    function render() {
      const pages = pagesFor(current);
      pages.forEach((p, i) => {
        p.hidden = i !== index;
      });
      counter!.textContent = `${index + 1} / ${pages.length}`;
      prevBtn!.disabled = index === 0;
      nextBtn!.disabled = index >= pages.length - 1;
      pins.forEach((p) => p.classList.toggle('is-active', p.dataset.pin === current));
    }

    function openPopup(id: string) {
      const panel = panelFor(id);
      if (!panel) return;
      current = id;
      index = 0;
      panels.forEach((p) => (p.hidden = p !== panel));
      popupTitle!.textContent = panel.dataset.title ?? id;
      popup!.hidden = false;
      popup!.classList.add('takeover');
      popup!.classList.remove('grow', 'shrink');
      void popup!.offsetWidth; // restart the entrance animation
      popup!.classList.add('grow');
      // Modes: paged (default), folders (projects), board (research)
      const mode = panel.dataset.mode ?? 'paged';
      prevBtn!.hidden = mode !== 'paged';
      nextBtn!.hidden = mode !== 'paged';
      counter!.hidden = mode !== 'paged';
      popup!.querySelector<HTMLElement>('[data-foot-os]')!.hidden = mode !== 'folders';
      popup!.querySelector<HTMLElement>('[data-foot-time]')!.hidden = mode !== 'folders';
      popup!.querySelector<HTMLElement>('.popup-foot')!.hidden = mode === 'board' || mode === 'log' || mode === 'flat';
      if (mode === 'folders') showDesk();
      if (mode === 'board') showBoard();
      if (mode === 'log') showLog();
      render();
    }

    function hidePopupNow() {
      popup!.hidden = true;
      popup!.classList.remove('takeover', 'grow', 'shrink');
    }

    // Closing from the close button or Escape shrinks the section back into its pin.
    function closePopup(animated = false) {
      current = '';
      pins.forEach((p) => p.classList.remove('is-active'));
      if (animated && !popup!.hidden && !reduce) {
        popup!.classList.remove('grow');
        popup!.classList.add('shrink');
        setTimeout(() => {
          if (popup!.classList.contains('shrink')) hidePopupNow();
        }, 350);
      } else {
        hidePopupNow();
      }
    }

    function step(d: number) {
      const n = pagesFor(current).length;
      index = Math.min(n - 1, Math.max(0, index + d));
      render();
    }

    // Full-screen entrance: the bio fades out, then the map zooms in from a distance.
    // Resolves once the map is in place.
    function enterMap(): Promise<void> {
      return new Promise((resolve) => {
        if (landing?.classList.contains('is-focus')) return resolve();
        const bio = document.querySelector<HTMLElement>('.bio-col');
        if (reduce) {
          landing?.classList.add('is-focus');
          return resolve();
        }
        bio?.classList.add('is-leaving');
        setTimeout(() => {
          landing?.classList.add('is-focus');
          bio?.classList.remove('is-leaving');
          stage!.classList.add('enter');
          stage!.addEventListener(
            'animationend',
            () => {
              stage!.classList.remove('enter');
              resolve();
            },
            { once: true },
          );
        }, 400);
      });
    }

    // Pin click: move to the full-screen map first, then zoom toward the pin and open its popup.
    async function openFromPin(pin: HTMLElement) {
      if (busy) return;
      busy = true;
      closePopup();
      await enterMap();
      const [x, y] = (pin.dataset.pos ?? '50,50').split(',');
      popup!.style.setProperty('--ox', `${x}%`);
      popup!.style.setProperty('--oy', `${y}%`);
      canvas!.style.setProperty('--zx', `${x}%`);
      canvas!.style.setProperty('--zy', `${y}%`);
      stage!.classList.add('is-zooming');
      const id = pin.dataset.pin ?? '';
      setTimeout(
        () => {
          stage!.classList.remove('is-zooming');
          openPopup(id);
          history.replaceState(null, '', `#${id}`);
          setTimeout(() => (busy = false), reduce ? 0 : 400);
        },
        reduce ? 0 : 650,
      );
    }

    pins.forEach((pin) =>
      pin.addEventListener('click', (e) => {
        e.preventDefault();
        openFromPin(pin);
      }),
    );

    popup.querySelector<HTMLElement>('[data-close]')?.addEventListener('click', () => {
      closePopup(true);
      history.replaceState(null, '', location.pathname);
    });
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));

    // Zoom and pan the map: buttons, mouse wheel, and drag while zoomed in
    const MIN_ZOOM = 1;
    const MAX_ZOOM = 3;
    let scale = 1;
    let panX = 0;
    let panY = 0;

    function applyView() {
      canvas!.style.setProperty('--us', String(scale));
      canvas!.style.setProperty('--px', `${panX}px`);
      canvas!.style.setProperty('--py', `${panY}px`);
      stage!.classList.toggle('can-pan', scale > MIN_ZOOM);
    }

    function clampPan() {
      const w = canvas!.offsetWidth;
      const h = canvas!.offsetHeight;
      const maxX = ((scale - 1) * w) / 2;
      const maxY = ((scale - 1) * h) / 2;
      panX = Math.min(maxX, Math.max(-maxX, panX));
      panY = Math.min(maxY, Math.max(-maxY, panY));
    }

    function zoomTo(next: number) {
      scale = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, next));
      canvas!.style.setProperty('--zx', '50%');
      canvas!.style.setProperty('--zy', '50%');
      if (scale === MIN_ZOOM) {
        panX = 0;
        panY = 0;
      }
      clampPan();
      applyView();
    }

    document.querySelector<HTMLElement>('[data-zoom-in]')?.addEventListener('click', () => zoomTo(scale * 1.25));
    document.querySelector<HTMLElement>('[data-zoom-out]')?.addEventListener('click', () => zoomTo(scale / 1.25));
    document.querySelector<HTMLElement>('[data-zoom-reset]')?.addEventListener('click', () => {
      panX = 0;
      panY = 0;
      zoomTo(MIN_ZOOM);
    });

    stage.addEventListener(
      'wheel',
      (e) => {
        if (busy) return;
        // Scrolling inside the popup scrolls the popup, not the map
        if ((e.target as HTMLElement).closest('.popup')) return;
        e.preventDefault();
        zoomTo(scale * (e.deltaY < 0 ? 1.12 : 1 / 1.12));
      },
      { passive: false },
    );

    let drag: { x: number; y: number; panX: number; panY: number; moved: boolean } | null = null;
    let suppressClick = false;

    stage.addEventListener('pointerdown', (e) => {
      if (busy || scale <= MIN_ZOOM) return;
      if ((e.target as HTMLElement).closest('.popup, .zoom-controls, .pin')) return;
      drag = { x: e.clientX, y: e.clientY, panX, panY, moved: false };
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 5) return;
      drag.moved = true;
      stage.classList.add('is-dragging');
      panX = drag.panX + dx;
      panY = drag.panY + dy;
      clampPan();
      applyView();
    });
    const endDrag = () => {
      if (!drag) return;
      suppressClick = drag.moved;
      drag = null;
      stage.classList.remove('is-dragging');
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
    // A drag that moved the map should not also count as a pin click
    stage.addEventListener(
      'click',
      (e) => {
        if (!suppressClick) return;
        suppressClick = false;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );

    // Arrow keys page through the popup; Escape closes it.
    document.addEventListener('keydown', (e) => {
      if (popup.hidden) return;
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'Escape') closePopup(true);
    });

    // Back to bio: the map pulls back into the distance, then the bio fades in.
    document.querySelector<HTMLElement>('[data-back-bio]')?.addEventListener('click', () => {
      closePopup();
      history.replaceState(null, '', location.pathname);
      const bio = document.querySelector<HTMLElement>('.bio-col');
      if (reduce) {
        landing?.classList.remove('is-focus');
        return;
      }
      stage!.classList.add('exit');
      setTimeout(() => {
        stage!.classList.remove('exit');
        landing?.classList.remove('is-focus');
        bio?.classList.add('bio-in');
        bio?.addEventListener('animationend', () => bio.classList.remove('bio-in'), { once: true });
      }, 500);
    });

    // "explore ./map": full-screen map with no popup open.
    document.querySelector<HTMLElement>('[data-explore]')?.addEventListener('click', () => {
      closePopup();
      history.replaceState(null, '', '#map');
      enterMap();
    });

    // Deep links (#research) and header nav clicks open the matching popup.
    // Experience git log: a commit opens its details, "← git log" returns
    function showLog() {
      document.querySelector<HTMLElement>('[data-log]')!.hidden = false;
      document.querySelectorAll<HTMLElement>('[data-cview]').forEach((v) => (v.hidden = true));
    }
    function openCommit(i: number) {
      document.querySelector<HTMLElement>('[data-log]')!.hidden = true;
      document.querySelectorAll<HTMLElement>('[data-cview]').forEach(
        (v) => (v.hidden = v.dataset.cview !== String(i)),
      );
    }
    document.querySelectorAll<HTMLButtonElement>('[data-commit]').forEach((b) =>
      b.addEventListener('click', () => openCommit(Number(b.dataset.commit))),
    );
    document.querySelectorAll<HTMLElement>('[data-cup]').forEach((b) =>
      b.addEventListener('click', showLog),
    );

    // Research whiteboard: a card opens its details, "← board" returns
    function showBoard() {
      document.querySelector<HTMLElement>('[data-board]')!.hidden = false;
      document.querySelectorAll<HTMLElement>('[data-rdetail]').forEach((d) => (d.hidden = true));
    }
    function openResearch(i: number) {
      document.querySelector<HTMLElement>('[data-board]')!.hidden = true;
      document.querySelectorAll<HTMLElement>('[data-rdetail]').forEach(
        (d) => (d.hidden = d.dataset.rdetail !== String(i)),
      );
    }
    document.querySelectorAll<HTMLButtonElement>('[data-rcard]').forEach((c) =>
      c.addEventListener('click', () => openResearch(Number(c.dataset.rcard))),
    );
    document.querySelectorAll<HTMLElement>('[data-rup]').forEach((b) =>
      b.addEventListener('click', showBoard),
    );
    document.querySelectorAll<HTMLButtonElement>('[data-rjump]').forEach((b) =>
      b.addEventListener('click', () => openResearch(Number(b.dataset.rjump))),
    );

    // Viewer's local time, shown in the projects footer
    const footTime = document.querySelector<HTMLElement>('[data-foot-time]');
    const tickClock = () => {
      if (footTime) {
        footTime.textContent = new Date().toLocaleString([], {
          weekday: 'short',
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit',
          second: '2-digit',
          timeZoneName: 'short',
        });
      }
    };
    tickClock();
    setInterval(tickClock, 1000);

    // Projects folders: click selects, double-click (or Enter) opens, "up" returns to the desktop
    // The folders stay on screen; an opened project appears as a window on the right
    function showDesk() {
      document.querySelector<HTMLElement>('[data-desk]')!.hidden = false;
      document.querySelector<HTMLElement>('[data-panel="projects"]')!.classList.remove('win-open');
      document.querySelectorAll<HTMLElement>('[data-project-win]').forEach((w) => (w.hidden = true));
    }
    function openProject(i: number) {
      document.querySelector<HTMLElement>('[data-desk]')!.hidden = false;
      document.querySelector<HTMLElement>('[data-panel="projects"]')!.classList.add('win-open');
      document.querySelectorAll<HTMLElement>('[data-project-win]').forEach(
        (w) => (w.hidden = w.dataset.projectWin !== String(i)),
      );
    }
    const folders = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-folder]'));
    folders.forEach((f) => {
      f.addEventListener('click', () => {
        folders.forEach((x) => x.classList.toggle('is-selected', x === f));
      });
      f.addEventListener('dblclick', () => openProject(Number(f.dataset.folder)));
      f.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') openProject(Number(f.dataset.folder));
      });
    });
    document.querySelectorAll<HTMLElement>('[data-up]').forEach((b) =>
      b.addEventListener('click', showDesk),
    );

    // Header nav: move to the map, then open the section. A deep link on load opens directly.
    window.addEventListener('hashchange', () => {
      const id = location.hash.slice(1);
      if (id && panelFor(id)) enterMap().then(() => openPopup(id));
    });
    const initial = location.hash.slice(1);
    if (initial && panelFor(initial)) {
      landing?.classList.add('is-focus');
      openPopup(initial);
    }
  }
</script>
