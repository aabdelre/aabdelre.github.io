  }

  /* Popup: section content shown over the map, one page at a time */
  .popup {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(600px, 92%);
    height: min(400px, 86%);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    font-family: var(--mono);
  }
  .popup[hidden] {
    display: none;
  }
  /* Takeover: the section fills the whole map and grows out of the pin that opened it */
  .popup {
    --ox: 50%;
    --oy: 50%;
  }
  .popup.takeover {
    inset: 0;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
