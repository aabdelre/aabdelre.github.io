    animation: mv 9s ease-in-out infinite alternate;
  }
  .mover-b {
    background: var(--muted);
  }
  @keyframes mv {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(120px, 40px);
    }
  }
  .pt {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--muted);
    animation: tw 3s ease-in-out infinite;
  }
  @keyframes tw {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.9;
    }
  }
  .tok,
  .glyph {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    opacity: 0.35;
    white-space: nowrap;
    animation: drift 14s ease-in-out infinite alternate;
  }
  .glyph {
    font-size: 10px;
    opacity: 0.5;
    animation: fall 5s linear infinite;
  }
  .tok.alt {
    color: var(--accent-hover);
  }
  .tok.warn {
    color: var(--warn);
  }
  @keyframes drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(18px, -22px);
    }
  }
  @keyframes fall {
    from {
      transform: translateY(-10px);
    }
    to {
      transform: translateY(60px);
    }
  }
  .brk {
    font-family: var(--mono);
    font-size: 16px;
    color: var(--muted);
    opacity: 0.4;
    animation: drift 10s ease-in-out infinite alternate;
  }
  .tri {
    width: 0;
    height: 0;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-bottom: 20px solid var(--border);
  }
  .tri-s {
    transform: scale(0.7);
  }
  .net {
    width: 120px;
    height: 2px;
    background: var(--border);
    transform: rotate(-4deg);
  }
  .scan {
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(
      transparent,
      color-mix(in srgb, var(--accent) 7%, transparent),
      transparent
    );
    animation: scan 7s linear infinite;
  }
  @keyframes scan {
    from {
      top: -80px;
    }
    to {
      top: 100%;
    }
  }
  .compass {
    right: 18px;
    top: 18px;
    width: 54px;
    height: 54px;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .compass::before {
    content: "N";
    position: absolute;
    top: 2px;
    color: var(--accent);
  }
  .needle {
    position: absolute;
    width: 2px;
    height: 22px;
    background: linear-gradient(var(--accent) 50%, var(--muted) 50%);
    animation: wobble 6s ease-in-out infinite alternate;
  }
  @keyframes wobble {
    from {
      transform: rotate(-12deg);
    }
    to {
      transform: rotate(14deg);
    }
  }
  .ring {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes ping {
    from {
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 1;
    }
    to {
      transform: translate(-50%, -50%) scale(1.8);
      opacity: 0;
    }
  }

  .w {
    position: absolute;
    z-index: 1;
    width: 220px;
    transform: translate(-50%, 0);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 10px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    pointer-events: none;
  }
