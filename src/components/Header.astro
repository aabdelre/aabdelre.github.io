---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/">Ahmed Abdelrehim</a>
    <nav>
      <a href={isHome ? '#education' : '/#education'}>Education</a>
      <a href={isHome ? '#experience' : '/#experience'}>Experience</a>
      <a href={isHome ? '#research' : '/#research'}>Research</a>
      <a href={isHome ? '#projects' : '/#projects'}>Projects</a>
      <a href={isHome ? '#writing' : '/#writing'}>Writing</a>
      <a href={isHome ? '#beyond' : '/#beyond'}>Beyond</a>
    </nav>
  </div>
</header>
